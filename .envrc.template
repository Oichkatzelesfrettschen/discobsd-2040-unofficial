# direnv template for the graft context graph. Copy it to .envrc, fill the
# values, and run `direnv allow` once; .envrc is ignored by Git and the
# template carries placeholders only, so a key never reaches a commit.
#
#   cp .envrc.template .envrc && direnv allow
#
# graft's structural commands (build, ask, grep, callers, skeleton, map,
# blast, check) read no model and need none of this. `graft build --deep`
# is the one command that calls a model, through GRAFT_PROVIDER,
# GRAFT_BASE_URL, GRAFT_API_KEY and GRAFT_MODEL. graft sends a whole file
# per request and records the answer through a forced tool call, so a slot
# needs 16k tokens or more (usb.c and flash.c under sys/arch/rp2040/dev
# overflow an 8k slot with an HTTP 400) and the server has to honor the
# tools field, which llama-server does only under --jinja.

# Route 1: the qwen-nvidia appliance on this workstation. Launch it with the
# 4B distill, which records a forced tool call (the 2B distill answers it in
# prose), at its registry ceiling of 32768 tokens, and with native tool calls
# on, which llama-server needs before it reads a request's tools field; then
# let its consumer script prove the endpoint and emit the four GRAFT_*
# exports, with the key read from the appliance's own key file.
#   QWEN_CHAT_TOOLS=on QWEN_CONTEXT_SIZE=32768 \
#   QWEN_MODEL_PATH=$HOME/models/Qwen3.8-4B-Distill-GGUF/Qwen3.8-4B-Q4_K_M.gguf \
#       scripts/qwen-launch.sh default              # in the qwen-nvidia checkout
#   eval "$(scripts/graft-consumer-env.sh)"          # same checkout, probes first
# The static form below is what that script emits for the default listener;
# the served single slot at 32768 tokens meets graft's whole-file requests.
export GRAFT_PROVIDER=openai
export GRAFT_BASE_URL=http://127.0.0.1:8080/v1
export GRAFT_MODEL=qwen-nvidia
export GRAFT_API_KEY=$(cat "$HOME/qwen-webui-state/api.key")

# Route 2: the Anthropic API under your own key.
#export GRAFT_PROVIDER=anthropic
#export GRAFT_API_KEY=sk-ant-REPLACE-ME
#export GRAFT_MODEL=claude-haiku-4-5-20251001

# Route 3: any OpenAI-compatible gateway (OpenAI, OpenRouter, LiteLLM).
#export GRAFT_PROVIDER=openai
#export GRAFT_BASE_URL=https://api.openai.com/v1
#export GRAFT_API_KEY=sk-REPLACE-ME
#export GRAFT_MODEL=gpt-4o-mini

# graft phones home with anonymous usage buckets unless told not to.
export DO_NOT_TRACK=1
