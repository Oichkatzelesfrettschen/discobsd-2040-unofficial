# The root script runs on Windows too: keep LF.
/discobsd-console text eol=lf

# The instruction gate compares the generated compatibility copy byte for byte.
/AGENTS.md text eol=lf
/.claude/CLAUDE.md text eol=lf

# The imported Tatham sources stay byte for byte as upstream wrote them,
# trailing blanks included (games/pzcommon/tatham.sha256 pins them).
/games/pzcommon/tatham/* -whitespace

# Unified patch context must retain the imported source's exact whitespace.
/tools/netbsd-patches/*.patch -whitespace

# The NetBSD msdosfs imports stay byte for byte as NetBSD wrote them,
# trailing blanks included (tools/netbsd-imports.manifest pins them).
/sys/fs/msdosfs/* -whitespace
/sbin/newfs_msdos/* -whitespace
/usr.sbin/makefs/** -whitespace
