# Object files
*.o
*.ko
*.obj
*.elf

# Libraries
*.lib
*.a

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
*.dis
*.0
*.img
multicall-bss-overlay.ld

Makefile.user
tools/renode/vendor/
tools/pico-sdk/vendor/

# Kernel build outputs. sys/arch/<machine>/compile/<CONFIG>/ is generated by
# tools/bin/config from its Config file; the linked image, per-build version
# stamps, and dependency files are rebuilt every build and are not tracked.
# The config scaffolding (Makefile, ioconf.c, ioconf.h, swapunix.c, Config)
# stays tracked because the default build consumes the committed compile dir
# without rerunning config. "make clean" (and clean-all) remove these.
sys/arch/*/compile/*/unix
sys/arch/*/compile/*/unix.bin
sys/arch/*/compile/*/unix.uf2
sys/arch/*/compile/*/unix.map
sys/arch/*/compile/*/vers.c
sys/arch/*/compile/*/boot2.bin
sys/arch/*/compile/*/boot2.S
sys/arch/*/compile/*/.compileversion
sys/arch/*/compile/*/.oldversion
sys/arch/*/compile/*/.deps/
sys/arch/*/compile/*/.params
sys/arch/*/compile/*/*.dep
sys/arch/*/compile/*/machine
sys/arch/*/compile/*/sys

# Benchmark and test program build outputs (a.out PROG targets have no
# extension; *.elf/*.o are already covered above).
benchmarks/coremark/coremark
benchmarks/coremark/coremark-host
tests/rp2040/fptest/fptest

# legacy/pdp11-v6: explicit host and target emulator builds.
legacy/pdp11-v6/usr.bin/pdp11/pdp11-host
legacy/pdp11-v6/usr.bin/pdp11/pdp11

# Core dumps. qemu-user writes a guest core named qemu_<prog>_<stamp>_<pid>.core
# into the guest's working directory whichever host core_pattern is set, so a
# faulting test under usr.bin/smlrc/tests or tests/rp2040 drops one in the tree.
# tests/rp2040/uarea_exchange/ confines its own to cores/; this catches the rest.
*.core
core.[0-9]*

# direnv: .envrc is the filled copy of .envrc.template
.envrc

# graft context graph, a regenerable local cache
graft/
