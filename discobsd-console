#
# discobsd-console -- the former name of gizmobsd--console. For one release this
# prints one line naming the new command and runs it with the same arguments.
set -eu

# Sourced, not executed, so the wrapper below still sees the name this file
# was invoked under (discobsd-term, discobsd-web or discobsd-link through a
# link) and picks the matching module.
here=$(cd "$(dirname "$0")" && pwd)
name=$(basename "$0")
case "$name" in
	discobsd-term|discobsd-web|discobsd-link|discobsd-console) ;;
	*) name=discobsd-console ;;
esac
echo "$name is renamed gizmobsd-${name#discobsd-}; use the new name" >&2
# shellcheck source=gizmobsd-console
. "$here/gizmobsd-console"
