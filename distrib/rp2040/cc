#!/bin/sh
#
# cc: the board's native C compile driver. It runs Smaller C, the Thumb
# assembler and the a.out linker in turn against the board's own crt0.o
# and libc.a. Written for the 2.11BSD sh on the board, which has no $(( ))
# arithmetic, no $( ) substitution, no ${var%pattern} editing and no
# ! in an if condition.
#
#   cc [-o out] [-S | -c] file.c ... file.s ... file.o ...
#
# -l options are accepted and ignored: libc.a is the only library.
set -eu

crt0=/usr/lib/crt0.o
libc=/usr/lib/libc.a
smlrc=/usr/libexec/smlrc
as=/usr/bin/as
ld=/usr/bin/ld

out=
stop_s=0
stop_o=0
srcs=
nsrcs=0
tmp=/tmp/cc$$

while [ $# -gt 0 ]; do
	case $1 in
	-o)
		shift
		if [ $# -eq 0 ]; then
			echo "cc: -o needs an argument" >&2
			exit 1
		fi
		out=$1
		;;
	-c)	stop_o=1 ;;
	-S)	stop_s=1 ;;
	-l*)	;;
	-*)
		echo "cc: unknown option $1" >&2
		exit 1
		;;
	*)
		srcs="$srcs $1"
		nsrcs=`expr $nsrcs + 1`
		;;
	esac
	shift
done
if [ "$nsrcs" -eq 0 ]; then
	echo "cc: no input files" >&2
	exit 1
fi
if [ -n "$out" ] && [ "$nsrcs" -gt 1 ] && [ "$stop_s$stop_o" != 00 ]; then
	echo "cc: -o with -c or -S takes exactly one input file" >&2
	exit 1
fi

# stem FILE: FILE without its directory and its .c/.s/.o suffix.
stem() {
	basename "$1" | sed 's/\.[cso]$//'
}

objs=
status=0
for src in $srcs; do
	base=`stem "$src"`
	case $src in
	*.c)
		if [ "$stop_s" -eq 1 ]; then
			asfile=${out:-$base.s}
		else
			asfile=$tmp.$base.s
		fi
		if "$smlrc" "$src" "$asfile"; then
			:
		else
			status=1
			break
		fi
		if [ "$stop_s" -eq 1 ]; then
			continue
		fi
		;;
	*.s)
		asfile=$src
		;;
	*.o)
		objs="$objs $src"
		continue
		;;
	*)
		echo "cc: $src: unknown file type" >&2
		status=1
		break
		;;
	esac
	if [ "$stop_o" -eq 1 ]; then
		ofile=${out:-$base.o}
	else
		ofile=$tmp.$base.o
	fi
	if "$as" "$asfile" -o "$ofile"; then
		:
	else
		status=1
		break
	fi
	if [ "$stop_o" -eq 1 ]; then
		continue
	fi
	objs="$objs $ofile"
done
if [ "$status" -eq 0 ] && [ "$stop_s$stop_o" = 00 ]; then
	"$ld" -o "${out:-a.out}" "$crt0" $objs "$libc" || status=1
fi
rm -f $tmp.*
exit $status
