#!/bin/sh
#
# discobsd-connect -- open a terminal on the DiscoBSD RP2040 console.
#
# The board is a USB CDC-ACM serial device with no network stack, so the
# console is a serial line, not telnet or ssh. This finds the board by its
# stable serial and launches the first serial terminal it finds, at the
# console's fixed 115200 8N1 with no flow control. Size the terminal window
# to 80x24, or run "resize" once connected to sync a different size.
#
# Works with the terminals packaged on Debian (apt install tio picocom
# minicom cu), CachyOS/Arch (pacman -S tio picocom minicom), and macOS
# (brew install tio picocom minicom); Windows users run discobsd-term.
set -eu

# Two boards on one host enumerate alike (2e8a:000a, serial "rp2040"); the
# by-id link and discobsd-term --list name whichever enumerated last. With
# more than one 2e8a device attached and no board named, this stops and lists
# the candidates. --usb-port PORT (or DISCOBSD_USB_PORT) names the board by
# its USB port, such as 1-3, and opens the tty that belongs to that port.
# An explicit device path names the board itself. Linux only: macOS has no
# sysfs, so there the selector is refused and discovery is unchanged.
# DISCOBSD_SYSFS_USB and DISCOBSD_DEVFS replace /sys/bus/usb/devices and /dev
# for tests.
sysfs_usb=${DISCOBSD_SYSFS_USB:-/sys/bus/usb/devices}
devfs=${DISCOBSD_DEVFS:-/dev}
usb_port=
opt_port=

die() {
	echo "discobsd-connect: $*" >&2
	exit 1
}

sysattr() {
	cat "$sysfs_usb/$1/$2" 2>/dev/null || true
}

port=
while [ $# -gt 0 ]; do
	case $1 in
	--usb-port)
		[ $# -ge 2 ] || die "--usb-port needs a port such as 1-3"
		opt_port=$2
		shift 2
		;;
	*)
		port=$1
		break
		;;
	esac
done

if [ -n "$opt_port" ]; then
	[ -z "$port" ] || die "give a device path or --usb-port, not both"
	usb_port=$opt_port
elif [ -z "$port" ]; then
	usb_port=${DISCOBSD_USB_PORT:-}
fi

if [ -n "$usb_port" ]; then
	# The port is joined into a sysfs path: bus-port[.port...] and nothing else.
	case $usb_port in
	*[!0-9.-]* | *..* | *. | -* | *-*-* | *-) die "$usb_port is not a USB port path such as 1-3 or 1-2.4" ;;
	[0-9]*-[0-9]*) ;;
	*) die "$usb_port is not a USB port path such as 1-3 or 1-2.4" ;;
	esac
	[ "$(uname -s)" = Linux ] || die "--usb-port reads Linux sysfs; this host has none"
	[ "$(sysattr "$usb_port" idVendor)" = 2e8a ] || die "USB port $usb_port holds no 2e8a device"
	# Interface 0 of the kernel's configuration is the console (by-id if00).
	for t in "$sysfs_usb/$usb_port/$usb_port":1.0/tty/*; do
		[ -e "$t" ] || continue
		port=$devfs/${t##*/}
		# /dev/ttyACMn is renumbered at every re-enumeration and may name the
		# other board next time; the terminal reopens the same name after a
		# reset. udev's by-path link for the same interface follows the
		# physical port, so it replaces the tty name whenever it points at it.
		for l in "$devfs"/serial/by-path/*-usb-*:"${usb_port#*-}":1.0; do
			if [ -e "$l" ] && [ "$l" -ef "$port" ]; then
				port=$l
				break
			fi
		done
		break
	done
	[ -n "$port" ] || die "port $usb_port holds 2e8a:$(sysattr "$usb_port" idProduct), which has no console tty"
elif [ -z "$port" ]; then
	devs=
	for d in "$sysfs_usb"/*; do
		[ -e "$d/idVendor" ] || continue
		n=${d##*/}
		[ "$(sysattr "$n" idVendor)" = 2e8a ] || continue
		devs="$devs$n 2e8a:$(sysattr "$n" idProduct) $(sysattr "$n" product)
"
	done
	case $devs in
	*'
'*'
'*)
		echo "discobsd-connect: more than one 2e8a device is attached; name the board with --usb-port PORT or DISCOBSD_USB_PORT:" >&2
		printf '%s' "$devs" | sed 's/^/  /' >&2
		exit 2
		;;
	esac
	# Linux names the console by identity under /dev/serial/by-id; macOS
	# presents it as a cu.usbmodem node. discobsd-term --list, from the
	# discobsd-host package, resolves either by USB identity.
	if command -v discobsd-term >/dev/null 2>&1; then
		port=$(discobsd-term --list 2>/dev/null | head -1) || port=""
	fi
	if [ -z "$port" ]; then
		for p in /dev/serial/by-id/usb-DiscoBSD_DiscoBSD_RP2040_console_rp2040-if00 \
		    /dev/discobsd /dev/cu.usbmodem*; do
			if [ -e "$p" ]; then
				port="$p"
				break
			fi
		done
	fi
fi
if [ -z "$port" ] || [ ! -e "$port" ]; then
	echo "discobsd-connect: no board found; is it plugged in and running?" >&2
	echo "  expected /dev/serial/by-id/usb-DiscoBSD_*_rp2040-if00" >&2
	exit 1
fi

echo "Connecting to $port at 115200 8N1. Log in as operator, no password; su for root." >&2

if command -v tio >/dev/null 2>&1; then
	# tio reconnects on its own when the board re-enumerates on reboot.
	exec tio -b 115200 -d 8 -p none -s 1 -f none "$port"
elif command -v picocom >/dev/null 2>&1; then
	exec picocom -b 115200 -d 8 -p 1 -f n "$port"
elif command -v minicom >/dev/null 2>&1; then
	exec minicom -b 115200 -8 -D "$port"
elif command -v cu >/dev/null 2>&1; then
	exec cu -l "$port" -s 115200
else
	echo "discobsd-connect: install one of tio, picocom, minicom or cu" >&2
	exit 1
fi
