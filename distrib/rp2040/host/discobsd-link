#!/usr/bin/env python3
#
# discobsd-link -- a short URL for the discobsd-web console.
#
# discobsd-web needs its token in the URL, which is long to type on a phone.
# This serves one page on a memorable port that redirects to the full
# tokenized console URL, so http://<host>:42069/ is all anyone on the LAN
# has to type. Anyone who can reach this port learns the token, so it is
# only as private as the network it listens on.
#
# Run: PYTHON=${PYTHON:-python3}; "$PYTHON" discobsd-link --to URL [--port N] [--bind ADDR]
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer


def main():
    args = sys.argv[1:]
    port, bind, to = 42069, "0.0.0.0", None
    i = 0
    while i < len(args):
        if args[i] == "--port":
            port = int(args[i + 1])
        elif args[i] == "--bind":
            bind = args[i + 1]
        elif args[i] == "--to":
            to = args[i + 1]
        else:
            sys.exit("usage: discobsd-link --to URL [--port N] [--bind ADDR]")
        i += 2
    if not to:
        sys.exit("discobsd-link: --to URL is required")

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(302)
            self.send_header("Location", to)
            self.send_header("Cache-Control", "no-store")
            self.end_headers()

        def log_message(self, fmt, *a):
            sys.stderr.write("%s - %s\n" % (self.client_address[0], fmt % a))

    httpd = HTTPServer((bind, port), Handler)
    print("discobsd-link: http://%s:%d/ -> %s" % (bind, port, to), flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
