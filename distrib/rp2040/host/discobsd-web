#!/usr/bin/env python3
#
# discobsd-web -- a portable web terminal for the DiscoBSD RP2040 console.
#
# The board is a USB CDC-ACM serial device with no network of its own, so
# the host it plugs into serves as the gateway: this program bridges the
# serial line to a browser terminal over a WebSocket, so any device on the
# local network -- a laptop, a phone, any operating system with a browser
# -- opens the console at http://<this-host>:7681/. It needs only Python
# and pyserial; the terminal itself is xterm.js, loaded from a CDN.
#
# Run: PYTHON=${PYTHON:-python3}; "$PYTHON" discobsd-web [--port N] [--bind ADDR] [DEVICE]
# Then open the printed URL. Log in as operator (no password); su for root.
#
# pyserial: Debian "apt install python3-serial"; Arch "pacman -S python-pyserial".
import base64
import glob
import hashlib
import socket
import struct
import sys
import threading
import hmac
from urllib.parse import urlparse, parse_qs
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

WS_MAGIC = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
BY_ID = "/dev/serial/by-id/*DiscoBSD*rp2040-if00"
BAUD = 115200
XTERM = "https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/lib/xterm.min.js"
XTERM_CSS = "https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0/css/xterm.min.css"

PAGE = """<!doctype html><html><head><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1,user-scalable=no">
<title>DiscoBSD console</title>
<link rel=stylesheet href="%s">
<style>html,body{margin:0;height:100%%;width:100%%;background:#000;overflow:hidden}
#t{position:absolute;top:0;left:0}
#s{position:fixed;top:4px;right:8px;color:#6a6;font:12px monospace;z-index:9}
</style></head><body>
<div id=s>connecting</div><div id=t></div>
<script src="%s"></script>
<script>
var term=new Terminal({cols:80,rows:24,fontFamily:"monospace",fontSize:14,
 cursorBlink:true,theme:{background:"#000000"}});
term.open(document.getElementById("t"));
var stat=document.getElementById("s");

// Fill the window: keep the console 80x24 and pick the largest font at
// which that grid fits, so the terminal grows and shrinks with the page
// while the board's size never changes. A monospace cell is about 0.6 of
// the font wide and about 1.2 tall.
function fit(){
 var fw=window.innerWidth/(80*0.6), fh=window.innerHeight/(24*1.2);
 var fs=Math.max(8,Math.floor(Math.min(fw,fh)));
 if(fs!==term.options.fontSize){term.options.fontSize=fs;}
 try{term.resize(80,24);}catch(e){}
}
window.addEventListener("resize",fit);
fit();

// Keep the terminal focused so typing goes to the console, not to
// Firefox quick-find, when the page is clicked or returned to.
function grab(){try{term.focus();}catch(e){}}
window.addEventListener("focus",grab);
window.addEventListener("load",grab);
document.addEventListener("click",grab);
document.addEventListener("visibilitychange",function(){if(!document.hidden)grab();});

var proto=location.protocol==="https:"?"wss":"ws";
var ws=new WebSocket(proto+"://"+location.host+"/ws");
ws.binaryType="arraybuffer";
ws.onopen=function(){stat.textContent="connected";grab();};
ws.onclose=function(){stat.textContent="disconnected -- reload to retry";};
ws.onmessage=function(e){
 var d=typeof e.data==="string"?e.data:
  new TextDecoder("latin1").decode(new Uint8Array(e.data));
 term.write(d);};
term.onData(function(d){if(ws.readyState===1)ws.send(d);});
</script></body></html>""" % (XTERM_CSS, XTERM)


def find_port():
    for name in sorted(glob.glob(BY_ID)):
        return name
    acm = sorted(glob.glob("/dev/ttyACM*"))
    return acm[-1] if acm else None


def open_serial(dev):
    import serial
    s = serial.Serial(dev, BAUD, timeout=0, write_timeout=2,
                      rtscts=False, dsrdtr=False)
    s.dtr = True
    s.rts = True
    return s


def ws_frame(payload):
    """Server-to-client text frame, unmasked (RFC 6455 5.2)."""
    n = len(payload)
    head = bytearray([0x81])
    if n < 126:
        head.append(n)
    elif n < 65536:
        head.append(126)
        head += struct.pack(">H", n)
    else:
        head.append(127)
        head += struct.pack(">Q", n)
    return bytes(head) + payload


def ws_read(rf):
    """Read one client frame; return (opcode, payload) or (None, None)."""
    h = rf.read(2)
    if len(h) < 2:
        return None, None
    op = h[0] & 0x0F
    masked = h[1] & 0x80
    ln = h[1] & 0x7F
    if ln == 126:
        ln = struct.unpack(">H", rf.read(2))[0]
    elif ln == 127:
        return None, None   # 64-bit length marker: refuse before reading it
    if ln > 65536:
        return None, None   # keystroke traffic never needs a larger frame
    mask = rf.read(4) if masked else b"\x00\x00\x00\x00"
    data = rf.read(ln)
    if masked:
        data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
    return op, data


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _authorized(self):
        """Loopback binds need no token; any other bind requires the shared
        secret as a Bearer header or ?token= query, compared in constant time."""
        srv = self.server
        if srv.is_loopback and not srv.token:
            return True
        tok = None
        auth = self.headers.get("Authorization", "")
        if auth.startswith("Bearer "):
            tok = auth[7:]
        if tok is None:
            tok = (parse_qs(urlparse(self.path).query).get("token") or [None])[0]
        if tok is not None and srv.token and hmac.compare_digest(tok, srv.token):
            return True
        self.send_response(401)
        self.send_header("Content-Length", "0")
        self.end_headers()
        return False

    def _origin_ok(self):
        """Reject a WebSocket upgrade whose Origin is not the page this server
        itself served, closing cross-site WebSocket hijacking."""
        origin = self.headers.get("Origin")
        if origin is None:
            return True
        return urlparse(origin).netloc == self.headers.get("Host", "")

    def do_GET(self):
        if not self._authorized():
            return
        if self.path.split("?")[0] == "/ws" and \
           self.headers.get("Upgrade", "").lower() == "websocket":
            return self.serve_ws()
        body = PAGE.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def serve_ws(self):
        if not self._authorized():
            return
        if not self._origin_ok():
            self.send_response(403)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        key = self.headers.get("Sec-WebSocket-Key", "")
        accept = base64.b64encode(
            hashlib.sha1((key + WS_MAGIC).encode()).digest()).decode()
        self.send_response(101)
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        self.end_headers()
        sock = self.connection
        dev = self.server.device
        # One console at a time: a serial line is a single session. A second
        # viewer is told the console is busy and closed, rather than fighting
        # over the same port.
        if not self.server.console_lock.acquire(blocking=False):
            try:
                sock.sendall(ws_frame(
                    b"\r\n  The console is in use by another session.\r\n"
                    b"  Try again later.\r\n"))
                time.sleep(0.2)
            except Exception:
                pass
            return
        try:
            ser = open_serial(dev)
        except Exception as exc:
            sock.sendall(ws_frame(("\r\ncannot open %s: %s\r\n" %
                                   (dev, exc)).encode()))
            self.server.console_lock.release()
            return
        alive = [True]

        def reader():
            # Serial to browser.
            while alive[0]:
                try:
                    d = ser.read(4096)
                except Exception:
                    break
                if d:
                    try:
                        sock.sendall(ws_frame(d))
                    except Exception:
                        break
                else:
                    time.sleep(0.02)
            alive[0] = False

        t = threading.Thread(target=reader, daemon=True)
        t.start()
        # getty prints its prompt once, before this client connected, so
        # prod the line with a newline to redraw the current prompt into
        # the fresh terminal instead of leaving a blank screen.
        try:
            ser.write(b"\r")
        except Exception:
            pass
        try:
            while alive[0]:
                op, data = ws_read(self.rfile)
                if op is None or op == 0x8:  # closed
                    break
                if op == 0x1 or op == 0x2:  # text or binary: keystrokes
                    try:
                        ser.write(data)
                    except Exception:
                        break
        finally:
            alive[0] = False
            try:
                ser.close()
            except Exception:
                pass
            self.server.console_lock.release()


def lan_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


def main():
    args = sys.argv[1:]
    port = 7681
    bind = "127.0.0.1"
    token = None
    dev = None
    i = 0
    while i < len(args):
        if args[i] == "--port":
            port = int(args[i + 1])
            i += 2
        elif args[i] == "--bind":
            bind = args[i + 1]
            i += 2
        elif args[i] == "--token":
            token = args[i + 1]
            i += 2
        else:
            dev = args[i]
            i += 1
    if dev is None:
        dev = find_port()
    if not dev:
        sys.stderr.write("discobsd-web: no board found (plug it in)\n")
        return 1
    try:
        import serial  # noqa: F401
    except ImportError:
        sys.stderr.write("discobsd-web: pyserial missing -- apt install "
                         "python3-serial, or pacman -S python-pyserial\n")
        return 1
    is_loopback = bind in ("127.0.0.1", "::1", "localhost")
    if not is_loopback and not token:
        sys.stderr.write("discobsd-web: refusing a non-loopback bind without "
                         "--token; a bare 0.0.0.0 bind exposes a login console "
                         "to the LAN with no authentication\n")
        return 1
    httpd = ThreadingHTTPServer((bind, port), Handler)
    httpd.device = dev
    httpd.token = token
    httpd.is_loopback = is_loopback
    httpd.console_lock = threading.Lock()
    ip = lan_ip()
    q = ("?token=" + token) if token else ""
    sys.stderr.write("DiscoBSD web console for %s\n" % dev)
    if is_loopback:
        sys.stderr.write("  open http://127.0.0.1:%d/%s (loopback only; "
                         "pass --bind 0.0.0.0 --token SECRET for LAN) -- Ctrl-C\n"
                         % (port, q))
    else:
        sys.stderr.write("  open http://%s:%d/%s from the LAN "
                         "(token required) -- Ctrl-C to stop\n" % (ip, port, q))
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        sys.stderr.write("\nstopped\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
