#!/bin/sh
# The udev rule grants /dev/gizmobsd to the gizmobsd group, so the group
# must exist before the rule is applied to a plugged-in board. The former
# discobsd group is created too, for one release.
set -e
if [ "$1" = configure ]; then
	for g in gizmobsd discobsd; do
		if ! getent group "$g" >/dev/null; then
			addgroup --quiet --system "$g"
		fi
	done
fi
#DEBHELPER#
