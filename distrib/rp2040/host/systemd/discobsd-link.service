[Unit]
Description=DiscoBSD console short link (port 42069)
Documentation=https://github.com/Oichkatzelesfrettschen/discobsd-2040-unofficial
After=discobsd-web.service

[Service]
EnvironmentFile=%h/.config/discobsd/web.env
ExecStart=/usr/bin/discobsd-link --to http://${DISCOBSD_HOST_IP}:7681/?token=${DISCOBSD_WEB_TOKEN}
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
