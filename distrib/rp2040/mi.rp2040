#
# Root file system manifest for a 1078-kbyte root on the Raspberry Pi Pico's
# QSPI flash. distrib/base/mi describes a 200-Mbyte SD card; this lists
# what a boot to a shell on the serial console runs: init, the commands
# /etc/rc calls, getty and login, and a working set of /bin.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

#
# Directories.
#
dir /bin
dir /dev
dir /etc
dir /sbin
dir /tmp
dir /usr
dir /home
dir /usr/bin
dir /usr/sbin
dir /usr/libexec
dir /usr/lib
dir /usr/share
dir /usr/share/misc
dir /root
dir /var
dir /var/log
dir /var/run

#
# Block devices, majors as sys/arch/rp2040/rp2040/conf.c orders bdevsw.
#
bdev /dev/swap
major 4             # Virtual swap device, mapped to real swap partition
minor 64

#
# Character devices.
#
cdev /dev/console
major 0
minor 0
cdev /dev/mem
major 1
minor 0
cdev /dev/kmem
major 1
minor 1
cdev /dev/null
major 1
minor 2
mode 666
cdev /dev/zero
major 1
minor 3
mode 666
cdev /dev/tty
major 2
minor 0
mode 666
cdev /dev/stdin
major 3
minor 0
cdev /dev/stdout
major 3
minor 1
cdev /dev/stderr
major 3
minor 2
cdev /dev/temp0
major 4
minor 0
cdev /dev/temp1
major 4
minor 1
cdev /dev/temp2
major 4
minor 2
cdev /dev/klog
major 5
minor 0

#
# The console: CDC-ACM over the board's USB cable.
#
cdev /dev/ttyUSB0
major 7
minor 0

#
# UART0 on GP0 and GP1, for a serial adapter.
#
cdev /dev/tty0
major 6
minor 0


#
# Files: /root
#
default
filemode 0644
file /root/.profile

symlink /.profile
target root/.profile

#
# Files: /etc
#
file /etc/fstab
file /etc/gettytab
file /etc/group
file /etc/motd
file /etc/passwd
file /etc/rc
file /etc/rc.local
file /etc/shadow
file /etc/shells
file /etc/ttys
file /etc/termcap

#
# /bin/box and /bin/sysbox are two a.outs holding the small utilities,
# dispatched on the name they are invoked by; the names below are hard
# links. See bin/box/Makefile.
#
default
filemode 0775

file /bin/sh
file /bin/ed
file /bin/ps
file /bin/md5
file /bin/expr
file /bin/box
file /bin/sysbox

file /sbin/reboot
file /sbin/shutdown
file /sbin/fsck
file /sbin/init
file /sbin/sysctl

file /usr/bin/awk
file /usr/bin/sed
file /usr/bin/grep
file /usr/bin/fgrep
file /usr/bin/find
file /usr/bin/sort
file /usr/bin/uniq
file /usr/bin/head
file /usr/bin/tail
file /usr/bin/tr
file /usr/bin/wc
file /usr/bin/cmp
file /usr/bin/more
file /usr/bin/basename
file /usr/bin/env
file /usr/bin/id
file /usr/bin/printf
file /usr/bin/tee
file /usr/bin/touch
file /usr/bin/xargs
file /usr/bin/du
file /usr/bin/nohup
file /usr/bin/tty
file /usr/bin/uname
file /usr/bin/true
file /usr/bin/false
file /usr/bin/login
file /usr/bin/passwd
file /usr/bin/re
file /usr/bin/picoc

file /usr/sbin/update

file /usr/libexec/getty
file /usr/libexec/smlrc

link /bin/cat
target /bin/box
link /bin/chgrp
target /bin/box
link /bin/chmod
target /bin/box
link /bin/cp
target /bin/box
link /bin/date
target /bin/sysbox
link /bin/dd
target /bin/sysbox
link /bin/df
target /bin/sysbox
link /bin/echo
target /bin/box
link /bin/hostname
target /bin/box
link /bin/kill
target /bin/box
link /bin/ln
target /bin/box
link /bin/ls
target /bin/box
link /bin/mkdir
target /bin/box
link /bin/mv
target /bin/box
link /bin/pwd
target /bin/box
link /bin/rm
target /bin/box
link /bin/rmdir
target /bin/box
link /bin/sleep
target /bin/box
link /bin/stty
target /bin/sysbox
link /bin/sync
target /bin/box
link /bin/test
target /bin/box
link /bin/[
target /bin/box
link /sbin/chown
target /bin/box
link /sbin/mknod
target /bin/sysbox
link /sbin/mount
target /bin/sysbox
link /sbin/umount
target /bin/sysbox
link /sbin/halt
target /sbin/reboot

#
# Files: /var
#
default
filemode 0644
file /var/log/messages
file /var/log/wtmp
