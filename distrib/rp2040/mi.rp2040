#
# Root file system manifest for a 1078-kbyte root on the Raspberry Pi Pico's
# QSPI flash. distrib/base/mi describes a 200-Mbyte SD card; this lists
# what a boot to a shell on the serial console runs: init, the commands
# /etc/rc calls, getty and login, and a working set of /bin.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

#
# Directories.
#
dir /bin
dir /dev
dir /etc
dir /sbin
dir /tmp
dir /usr
dir /home
dir /usr/bin
dir /usr/sbin
dir /usr/libexec
dir /usr/lib
dir /usr/games
dir /usr/share
dir /usr/share/misc
dir /root
dir /var
dir /var/log
dir /var/run

#
# Block devices, majors as sys/arch/rp2040/rp2040/conf.c orders bdevsw.
#
bdev /dev/swap
major 4             # Virtual swap device, mapped to real swap partition
minor 64

#
# Character devices.
#
cdev /dev/console
major 0
minor 0
cdev /dev/mem
major 1
minor 0
cdev /dev/kmem
major 1
minor 1
cdev /dev/null
major 1
minor 2
mode 666
cdev /dev/zero
major 1
minor 3
mode 666
cdev /dev/tty
major 2
minor 0
mode 666
cdev /dev/stdin
major 3
minor 0
cdev /dev/stdout
major 3
minor 1
cdev /dev/stderr
major 3
minor 2
cdev /dev/temp0
major 4
minor 0
cdev /dev/temp1
major 4
minor 1
cdev /dev/temp2
major 4
minor 2
cdev /dev/klog
major 5
minor 0

#
# The console: CDC-ACM over the board's USB cable.
#
cdev /dev/ttyUSB0
major 7
minor 0

#
# UART0 on GP0 and GP1, for a serial adapter.
#
cdev /dev/tty0
major 6
minor 0


#
# Files: /root
#
default
filemode 0644
file /root/.profile

symlink /.profile
target root/.profile

#
# Files: /etc
#
file /etc/fstab
file /etc/gettytab
file /etc/group
file /etc/motd
file /etc/passwd
file /etc/rc
file /etc/rc.local
file /etc/shadow
file /etc/shells
file /etc/ttys
file /etc/termcap

#
# /bin/box and /bin/sysbox are two a.outs holding the small utilities,
# dispatched on the name they are invoked by; the names below are hard
# links. See bin/box/Makefile.
#
default
filemode 0775

file /bin/sh
file /bin/ed
file /bin/ps
file /bin/box
file /bin/sysbox

file /sbin/fsck
file /sbin/init
file /sbin/adminbox

file /usr/bin/awk
file /usr/bin/sed
file /usr/bin/grep
file /usr/bin/fgrep
file /usr/bin/find
file /usr/bin/sort
file /usr/bin/nohup
file /usr/bin/true
file /usr/bin/false
file /usr/bin/login
file /usr/bin/passwd
file /usr/bin/re
file /usr/bin/kilo
file /usr/bin/textbox
file /usr/bin/utilbox
file /usr/bin/tail
file /usr/bin/tee
file /usr/bin/du
file /usr/bin/as
file /usr/bin/ld
file /usr/bin/cc

file /usr/sbin/update

file /usr/libexec/getty
file /usr/libexec/smlrc

file /usr/games/gamebox

#
# The native compile chain's library: cc (smlrc, as, ld) needs these to
# link a program, so they carry data mode rather than the 0775 above.
#
default
filemode 0664
file /usr/lib/libc.a
file /usr/lib/crt0.o

default
filemode 0775

link /bin/cat
target /bin/box
link /bin/chgrp
target /bin/box
link /bin/chmod
target /bin/box
link /bin/cp
target /bin/box
link /bin/date
target /bin/sysbox
link /bin/dd
target /bin/sysbox
link /bin/df
target /bin/sysbox
link /bin/echo
target /bin/box
link /bin/hostname
target /bin/box
link /bin/kill
target /bin/box
link /bin/ln
target /bin/box
link /bin/ls
target /bin/box
link /bin/mkdir
target /bin/box
link /bin/mv
target /bin/box
link /bin/pwd
target /bin/box
link /bin/rm
target /bin/box
link /bin/rmdir
target /bin/box
link /bin/sleep
target /bin/box
link /bin/stty
target /bin/sysbox
link /bin/sync
target /bin/box
link /bin/test
target /bin/box
link /bin/[
target /bin/box
link /sbin/chown
target /bin/box
link /sbin/mknod
target /bin/sysbox
link /sbin/mount
target /bin/sysbox
link /sbin/umount
target /bin/sysbox
#
# /sbin/adminbox is a fourth a.out holding shutdown, reboot and
# sysctl, dispatched the same way as box and sysbox; halt and
# fasthalt are names reboot's own argv[0] check answers to, so they
# link straight to adminbox too. See sbin/adminbox/Makefile.
#
link /sbin/shutdown
target /sbin/adminbox
link /sbin/reboot
target /sbin/adminbox
link /sbin/sysctl
target /sbin/adminbox
link /sbin/halt
target /sbin/adminbox

#
# /usr/bin/textbox is a third a.out holding the sbase text utilities
# this tree lacked, dispatched the same way as box and sysbox; the
# names below are hard links. See sbin/textbox/Makefile and
# sys/arch/rp2040/doc/research/posix-tools.md. mkfifo builds but is not
# shipped: the kernel has no FIFO support, so the node it makes passes
# nothing through. look and deroff (Seventh Edition Unix, Caldera
# ancient-Unix grant) join the same box; see
# sys/arch/rp2040/doc/research/v7-tools.md.
#
link /usr/bin/cut
target /usr/bin/textbox
link /usr/bin/paste
target /usr/bin/textbox
link /usr/bin/seq
target /usr/bin/textbox
link /usr/bin/dirname
target /usr/bin/textbox
link /usr/bin/nl
target /usr/bin/textbox
link /usr/bin/cksum
target /usr/bin/textbox
link /usr/bin/expand
target /usr/bin/textbox
link /usr/bin/unexpand
target /usr/bin/textbox
link /usr/bin/uuencode
target /usr/bin/textbox
link /usr/bin/uudecode
target /usr/bin/textbox
link /usr/bin/fold
target /usr/bin/textbox
link /usr/bin/rev
target /usr/bin/textbox
link /usr/bin/comm
target /usr/bin/textbox
link /usr/bin/look
target /usr/bin/textbox
link /usr/bin/deroff
target /usr/bin/textbox

#
# /usr/bin/utilbox is a fourth a.out holding the usr.bin tools that
# share the most libc; the names below are hard links, expr and md5
# among them even though their standalone form lived in /bin, since
# a hard link crosses directories on one filesystem the way
# /sbin/chown already links to /bin/box above. See
# sbin/utilbox/Makefile and sys/arch/rp2040/doc/research/utilbox.md
# for what stayed out and why: find (colliding globals with bigram
# and code in its own directory), sed and sort (colliding globals
# with expr, more and each other), nohup (a shell script, no a.out),
# and passwd (setuid root, so a shared multicall binary would hand
# every linked name root).
#
link /bin/expr
target /usr/bin/utilbox
link /bin/md5
target /usr/bin/utilbox
link /usr/bin/id
target /usr/bin/utilbox
link /usr/bin/more
target /usr/bin/utilbox
link /usr/bin/uniq
target /usr/bin/utilbox
link /usr/bin/head
target /usr/bin/utilbox
link /usr/bin/tr
target /usr/bin/utilbox
link /usr/bin/wc
target /usr/bin/utilbox
link /usr/bin/cmp
target /usr/bin/utilbox
link /usr/bin/basename
target /usr/bin/utilbox
link /usr/bin/env
target /usr/bin/utilbox
link /usr/bin/printf
target /usr/bin/utilbox
link /usr/bin/touch
target /usr/bin/utilbox
link /usr/bin/xargs
target /usr/bin/utilbox
link /usr/bin/tty
target /usr/bin/utilbox
link /usr/bin/uname
target /usr/bin/utilbox

#
# /usr/games/gamebox is a fourth a.out holding fifteen, keen and
# bubble, dispatched the same way as box, sysbox and textbox; the
# names below are hard links. See games/gamebox/Makefile and
# sys/arch/rp2040/doc/research/games.md.
#
link /usr/games/fifteen
target /usr/games/gamebox
link /usr/games/keen
target /usr/games/gamebox
link /usr/games/bubble
target /usr/games/gamebox

#
# Files: /var
#
default
filemode 0644
file /var/log/messages
file /var/log/wtmp
