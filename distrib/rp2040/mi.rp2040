#
# Root file system manifest for the Raspberry Pi Pico's QSPI flash: a
# 1536 KB Dhara region that yields 979 KB of blocks (df on the board). distrib/base/mi describes a 200-Mbyte SD card; this lists
# what a boot to a shell on the serial console runs: init, the commands
# /etc/rc calls, getty and login, and a working set of /bin.
#
# Lines between "#closure NAME" and "#endclosure NAME" belong to the
# optional closure NAME and reach the image only when the selected profile
# names that closure; every other line is the base system and always ships.
# distrib/rp2040/profiles declares the profiles and the closure
# dependencies, distrib/rp2040/mkmanifest.py resolves them, and
# sys/arch/rp2040/doc/PROFILES.md is the authority for the scheme. A
# closure opens more than once, because the directory, the binary and the
# hard links that belong to one feature sit in different sections here.
# fsutil skips a comment line whole (tools/fsutil/manifest.c), so the
# markers leave the manifest fsutil reads unchanged.
#
default
owner 0
group 0
dirmode 0775
filemode 0664

#
# Directories.
#
dir /bin
dir /dev
dir /etc
dir /sbin
dir /tmp
dir /usr
dir /home
#closure sdcard
dir /mnt
#endclosure sdcard
dir /home/operator
owner 2
group 5
dir /usr/bin
dir /usr/sbin
dir /usr/libexec
#closure toolchainlib
dir /usr/lib
#endclosure toolchainlib
#closure gamesdir
dir /usr/games
#endclosure gamesdir
dir /usr/share
dir /usr/share/misc
dir /root
dir /var
dir /var/log
dir /var/run

#
# Block devices, majors as sys/arch/rp2040/rp2040/conf.c orders bdevsw.
#
bdev /dev/swap
major 4             # Virtual swap device, mapped to real swap partition
minor 64

#closure sdcard
#
# The PicoCalc's SD card: block major 5 and raw major 11 (rp2040/conf.c).
# Minor 0 is the whole card, 1 to 4 the MBR partitions a to d. The root
# has 128 inodes, so the image carries the whole card and the first two
# partitions; mknod makes the other two.
#
bdev /dev/sd0
major 5
minor 0
bdev /dev/sd0a
major 5
minor 1
bdev /dev/sd0b
major 5
minor 2
cdev /dev/rsd0
major 11
minor 0
cdev /dev/rsd0a
major 11
minor 1
cdev /dev/rsd0b
major 11
minor 2
#endclosure sdcard

#
# Character devices.
#
cdev /dev/console
major 0
minor 0
cdev /dev/mem
major 1
minor 0
cdev /dev/kmem
major 1
minor 1
cdev /dev/null
major 1
minor 2
mode 666
cdev /dev/zero
major 1
minor 3
mode 666
cdev /dev/tty
major 2
minor 0
mode 666
cdev /dev/stdin
major 3
minor 0
cdev /dev/stdout
major 3
minor 1
cdev /dev/stderr
major 3
minor 2
#
# The temporary devices carve extents from raw swap on TFALLOC (dev/swap.c).
# fsck uses temp0 for its tables on a large root; temp1 and temp2 have no
# consumer on this root and are kept for programs that ask for them.
#
cdev /dev/temp0
major 4
minor 0
cdev /dev/temp1
major 4
minor 1
cdev /dev/temp2
major 4
minor 2
#
# No /dev/klog: cdevsw major 5 is the kernel message log, which the PICO
# kernel does not build (LOG_ENABLED is unset), and the root ships no
# dmesg. The USB console's transmit ring carries the boot messages.
#

#
# The console: CDC-ACM over the board's USB cable.
#
cdev /dev/ttyUSB0
major 7
minor 0

#
# UART0 on GP0 and GP1, for a serial adapter.
#
cdev /dev/tty0
major 6
minor 0

#closure lcdgfx
#
# The PicoCalc's pixel device, minor 1 of the console's character major 10
# (sys/arch/rp2040/rp2040/conf.c, sys/arch/rp2040/dev/lcdgfx.c). It takes
# the panel from the text console while open, one program at a time, and
# any user may open it as any user may write /dev/tty.
#
cdev /dev/lcdgfx
major 10
minor 1
mode 666
#endclosure lcdgfx


#
# Files: /root
#
default
filemode 0644
file /root/.profile

symlink /.profile
target root/.profile

file /home/operator/.profile
owner 2
group 5

#
# Files: /etc
#
file /etc/COPYRIGHT
file /etc/release
file /etc/fstab
file /etc/gettytab
file /etc/group
file /etc/motd
file /etc/passwd
file /etc/rc
file /etc/rc.local
file /etc/shadow
mode 0600
file /etc/shells
file /etc/ttys
file /etc/termcap
file /etc/menu

#
# /bin/box and /bin/sysbox are two a.outs holding the small utilities,
# dispatched on the name they are invoked by; the names below are hard
# links. Every `pack` entry is a raw OMAGIC build artifact that fsutil
# installs as a versioned, CRC-checked packed executable. Scripts, archives,
# and other data retain `file`. See sbin/box/Makefile and
# sys/sys/exec_hsaout.h.
#
default
filemode 0775

pack /bin/sh
pack /bin/ed
pack /bin/ps
pack /bin/box
pack /bin/sysbox
pack /bin/tar

pack /sbin/fsck
pack /sbin/init
pack /sbin/adminbox

pack /usr/bin/awk
#closure coremark
pack /usr/bin/coremark
#endclosure coremark
#closure bc
pack /usr/bin/bc
#endclosure bc
#closure dc
pack /usr/bin/dc
#endclosure dc
#closure calc
pack /usr/bin/calc
#endclosure calc
pack /usr/bin/sed
pack /usr/bin/grepbox
pack /usr/bin/find
pack /usr/bin/login
pack /usr/bin/passwd
mode 04755
pack /usr/bin/su
mode 04751
pack /usr/bin/stevie
pack /usr/bin/menu
pack /usr/bin/textbox
pack /usr/bin/utilbox
pack /usr/bin/tail
pack /usr/bin/tee
pack /usr/bin/du
#closure as
pack /usr/bin/as
#endclosure as
#closure ld
pack /usr/bin/ld
#endclosure ld
#closure cc
file /usr/bin/cc
#endclosure cc
file /usr/bin/mputest

#
# Archivers. /bin/tar writes POSIX ustar by default and reads the v7
# header too; its -z and -Z fork /usr/bin/compress over a pipe, so the
# codec has to be here for those flags to work. compress dispatches on
# argv[0], so uncompress and zcat are hard links to it rather than three
# copies of a 13280-byte a.out. /usr/bin/cpio reads and writes the POSIX
# odc format.
#
pack /usr/bin/compress
pack /usr/bin/cpio

pack /usr/sbin/update

pack /usr/libexec/getty
#closure smlrc
pack /usr/libexec/smlrc
#endclosure smlrc
#closure gamebox
pack /usr/games/gamebox
#endclosure gamebox
#closure puzzlebox
pack /usr/games/puzzlebox
#endclosure puzzlebox

#
# The native compile chain's library: cc (smlrc, as, ld) needs these to
# link a program, so they carry data mode rather than the 0775 above.
#
default
filemode 0664
#closure toolchainlib
file /usr/lib/libc.a
#endclosure toolchainlib
#closure toolchainlib
file /usr/lib/crt0.o
#endclosure toolchainlib

#
# bc -l reads its function library from /usr/share/misc/bc.library, read-only
# as usr.bin/bc/Makefile installs it.
#
default
filemode 0444
#closure bc
file /usr/share/misc/bc.library
#endclosure bc

default
filemode 0775

link /usr/bin/uncompress
target /usr/bin/compress
link /usr/bin/zcat
target /usr/bin/compress
link /bin/cat
target /bin/box
link /bin/chgrp
target /bin/box
link /bin/chmod
target /bin/box
link /bin/cp
target /bin/box
link /bin/date
target /bin/sysbox
link /bin/dd
target /bin/sysbox
link /bin/df
target /bin/sysbox
link /bin/echo
target /bin/box
link /bin/hostname
target /bin/box
link /bin/kill
target /bin/box
link /bin/ln
target /bin/box
link /bin/ls
target /bin/box
link /bin/mkdir
target /bin/box
link /bin/mv
target /bin/box
link /bin/pwd
target /bin/box
link /bin/rm
target /bin/box
link /bin/rmdir
target /bin/box
link /bin/sleep
target /bin/box
link /bin/stty
target /bin/sysbox
link /bin/sync
target /bin/box
link /bin/test
target /bin/box
link /bin/[
target /bin/box
link /sbin/chown
target /bin/box
link /sbin/mknod
target /bin/sysbox
link /sbin/mount
target /bin/sysbox
link /sbin/umount
target /bin/sysbox
#
# /sbin/adminbox holds shutdown, reboot, sysctl, timeout, true, false and
# nohup, dispatched the same way as box and sysbox; halt and bootloader are
# names reboot's own argv[0] check answers to, so they link straight to
# adminbox too. See sbin/adminbox/Makefile.
#
link /sbin/shutdown
target /sbin/adminbox
link /sbin/reboot
target /sbin/adminbox
link /sbin/sysctl
target /sbin/adminbox
link /sbin/halt
target /sbin/adminbox
link /sbin/bootloader
target /sbin/adminbox

#
# /usr/bin/textbox holds the sbase text utilities
# this tree lacked, dispatched the same way as box and sysbox; the
# names below are hard links. See sbin/textbox/Makefile and
# sys/arch/rp2040/doc/research/posix-tools.md. mkfifo builds but is not
# shipped: the kernel has no FIFO support, so the node it makes passes
# nothing through. look and deroff (Seventh Edition Unix, Caldera
# ancient-Unix grant) join the same box; see
# sys/arch/rp2040/doc/research/v7-tools.md.
#
link /usr/bin/cut
target /usr/bin/textbox
link /usr/bin/paste
target /usr/bin/textbox
link /usr/bin/seq
target /usr/bin/textbox
link /usr/bin/dirname
target /usr/bin/textbox
link /usr/bin/nl
target /usr/bin/textbox
link /usr/bin/cksum
target /usr/bin/textbox
link /usr/bin/expand
target /usr/bin/textbox
link /usr/bin/unexpand
target /usr/bin/textbox
link /usr/bin/uuencode
target /usr/bin/textbox
link /usr/bin/uudecode
target /usr/bin/textbox
link /usr/bin/readlink
target /usr/bin/textbox
link /usr/bin/realpath
target /usr/bin/textbox
link /usr/bin/fold
target /usr/bin/textbox
link /usr/bin/rev
target /usr/bin/textbox
link /usr/bin/comm
target /usr/bin/textbox
link /usr/bin/look
target /usr/bin/textbox
link /usr/bin/deroff
target /usr/bin/textbox
link /usr/bin/colrm
target /usr/bin/textbox

#
# /usr/bin/utilbox holds the usr.bin tools that
# share the most libc; the names below are hard links, expr and md5
# among them even though their standalone form lived in /bin, since
# a hard link crosses directories on one filesystem the way
# /sbin/chown already links to /bin/box above. See
# sbin/utilbox/Makefile and sys/arch/rp2040/doc/research/utilbox.md
# for what stayed out and why: find needs bounded ownership for its
# user and group caches, sed keeps its compiled program live alongside
# its work buffers, passwd stays isolated from general applets, and su
# retains its own setuid inode. sort
# joins after its private globals are localized and its byte tables and
# merge-pointer array are reduced.
#
link /bin/expr
target /usr/bin/utilbox
link /bin/md5
target /usr/bin/utilbox
link /usr/bin/id
target /usr/bin/utilbox
link /usr/bin/whoami
target /usr/bin/utilbox
link /usr/bin/groups
target /usr/bin/utilbox
link /usr/bin/logname
target /usr/bin/utilbox
link /usr/bin/more
target /usr/bin/utilbox
link /usr/bin/uniq
target /usr/bin/utilbox
link /usr/bin/head
target /usr/bin/utilbox
link /usr/bin/tr
target /usr/bin/utilbox
link /usr/bin/wc
target /usr/bin/utilbox
link /usr/bin/cmp
target /usr/bin/utilbox
link /usr/bin/sort
target /usr/bin/utilbox
link /usr/bin/grep
target /usr/bin/grepbox
link /usr/bin/fgrep
target /usr/bin/grepbox
link /usr/bin/basename
target /usr/bin/utilbox
link /usr/bin/env
target /usr/bin/utilbox
link /usr/bin/printf
target /usr/bin/utilbox
link /usr/bin/touch
target /usr/bin/utilbox
link /usr/bin/xargs
target /usr/bin/utilbox
link /usr/bin/tty
target /usr/bin/utilbox
link /usr/bin/resize
target /usr/bin/utilbox
link /usr/bin/uname
target /usr/bin/utilbox
link /usr/bin/md
target /usr/bin/utilbox
link /usr/bin/time
target /usr/bin/utilbox
link /usr/bin/true
target /sbin/adminbox
link /usr/bin/false
target /sbin/adminbox
link /usr/bin/nohup
target /sbin/adminbox
link /usr/bin/timeout
target /sbin/adminbox
link /usr/bin/vi
target /usr/bin/stevie
link /usr/bin/vim
target /usr/bin/stevie

#
# /usr/games/gamebox holds fifteen, keen, bubble, fourfall, coil and
# ridge, and /usr/games/puzzlebox holds flood, samegame, unruly and
# lightup, dispatched the same way as box, sysbox and textbox; the
# names below are hard links. The games closure carries gamebox and its
# links except ridge's, which draws on /dev/lcdgfx and so has a closure
# outside the group that needs the lcdgfx closure; the puzzles closure
# carries puzzlebox and its links. See games/gamebox/Makefile,
# games/puzzlebox/Makefile and sys/arch/rp2040/doc/research/games.md.
#
#closure fifteen
link /usr/games/fifteen
target /usr/games/gamebox
#endclosure fifteen
#closure keen
link /usr/games/keen
target /usr/games/gamebox
#endclosure keen
#closure bubble
link /usr/games/bubble
target /usr/games/gamebox
#endclosure bubble
#closure fourfall
link /usr/games/fourfall
target /usr/games/gamebox
#endclosure fourfall
#closure coil
link /usr/games/coil
target /usr/games/gamebox
#endclosure coil
#closure ridge
link /usr/games/ridge
target /usr/games/gamebox
#endclosure ridge
#closure flood
link /usr/games/flood
target /usr/games/puzzlebox
#endclosure flood
#closure samegame
link /usr/games/samegame
target /usr/games/puzzlebox
#endclosure samegame
#closure unruly
link /usr/games/unruly
target /usr/games/puzzlebox
#endclosure unruly
#closure lightup
link /usr/games/lightup
target /usr/games/puzzlebox
#endclosure lightup

#
# Files: /var
#
default
filemode 0644
file /var/log/messages
file /var/log/wtmp
