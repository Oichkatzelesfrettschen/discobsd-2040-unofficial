 "recursion": [
  {
   "function": "wakeup",
   "depth": 2,
   "reason": "the nested call wakes the swapper on &runout after clearing runout, and the swapper's wakeup finds runout zero"
  },
  {
   "function": "psignal",
   "depth": 2,
   "reason": "the nested call posts SIGCHLD to the parent, which is not a stop signal and so does not reach the SIGCHLD post again"
  },
  {
   "function": "mfree",
   "depth": 2,
   "reason": "the nested call frees the part of a run past the ring end, which lies inside the ring and does not split again"
  },
  {
   "function": "indirtrunc",
   "depth": 3,
   "reason": "one call per indirection level, entered at TRIPLE at most"
  },
  {
   "function": "errno_message_expand",
   "depth": 5,
   "reason": "the deepest left expansion of errno_message_rules, computed from the table at f48e19c9"
  }
 ],
 "excluded": [
  {
   "callee": "panic",
   "reason": "a panic's chain is the root named panic; its sum with the chain that raised it is not bounded"
  }
 ],
 "reentry": [
  {
   "function": "ttypend",
   "reason": "ttypend clears PENDIN before it replays the queue and only ttioctl sets it, so the ttyinput calls it makes do not enter it again"
  },
  {
   "function": "exit",
   "reason": "exit clears P_TRACED and ignores every signal before its first call, so a sleep under it finds no signal and cannot reach exit again"
  },
  {
   "function": "exec_script_check",
   "reason": "EXEC_INTERPRETED is set on the first entry and the second returns ENOEXEC before any call"
  }
 ],
