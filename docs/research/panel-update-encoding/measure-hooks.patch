+				bestk = k;
+			}
+		}
+		for (r = 0; r < 25; r++) {
+			int ch = 0;
+			for (c = 0; c < cols; c++)
+				if (memcmp(cell + 2 * (r * cols + c), m_cells + 2 * (r * cols + c), 2) != 0) {
+					ch = 1;
+					spanpx += cpx;
+				}
+			lines += ch;
+		}
+		memcpy(m_cells, cell, 2 * cols * 25);
+	}
+	if (mdump == NULL && (p = getenv("I86_MDUMP")) != NULL)
+		mdump = fopen(p, "wb");
+	if (mdump != NULL && (pixels != m_px || fillpx != m_fill || lines)) {
