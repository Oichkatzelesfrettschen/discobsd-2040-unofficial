+static unsigned
+m_gdiff(const uint8_t *a, const uint8_t *b)
+{
+	unsigned b0, b1;
+
+	for (b0 = 0; b0 < 80 && a[b0] == b[b0]; b0++)
+		;
+	if (b0 == 80)
+		return (0);
+	for (b1 = 79; a[b1] == b[b1]; b1--)
+		;
+	return ((b1 - b0 + 1) * 4);
+}
+static void
+measure(unsigned cols)
+{
+	unsigned y, lines = 0, spanpx = 0, r, c, k, best = ~0u, bestk = 0, n;
+	const char *p;
+
+	if (mlog == NULL) {
+		if ((p = getenv("I86_MLOG")) == NULL)
+			return;
+		if ((mlog = fopen(p, "w")) == NULL)
+			return;
+	}
+	if (kind != K_TEXT) {
+		for (k = 0; k <= 24; k++) {
+			for (n = 0, y = 0; y < LINES; y++)
