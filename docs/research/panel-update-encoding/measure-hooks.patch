+		else {
+			fwrite(bank[0], 8000, 1, mdump);
+			fwrite(bank[1], 8000, 1, mdump);
+		}
+		panel_dump(mdump);
+		fflush(mdump);
+	}
+	if (pixels != m_px || fillpx != m_fill || lines)
+		fprintf(mlog, "%c %lu %lu %u %u %u %u\n", kind == K_TEXT ? 'T' : 'G',
+		    pixels - m_px, fillpx - m_fill, lines, spanpx, best, bestk);
+	fflush(mlog);
+	m_px = pixels;
+	m_fill = fillpx;
+}
