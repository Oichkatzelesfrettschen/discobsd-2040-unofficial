+			if (n < best) {
+				best = n;
+				bestk = k;
+			}
+		}
+		for (y = 0; y < LINES; y++) {
+			const uint8_t *now = bank[y & 1] + (y >> 1) * 80;
+			uint8_t *old = m_shadow[y & 1] + (y >> 1) * 80;
+			n = m_gdiff(now, old);
+			if (n == 0)
+				continue;
+			lines++;
+			spanpx += n;
+		}
+		for (y = 0; y < LINES; y++)
+			memcpy(m_shadow[y & 1] + (y >> 1) * 80, bank[y & 1] + (y >> 1) * 80, 80);
+	} else {
