diff --git a/sys/arch/rp2040/dev/flash.c b/sys/arch/rp2040/dev/flash.c
index 6f1185a1..fe406ae2 100644
--- a/sys/arch/rp2040/dev/flash.c
+++ b/sys/arch/rp2040/dev/flash.c
@@ -65,6 +65,8 @@
 #include <rp2040/dhara/map.h>
 #include <rp2040/rp2040/clock_catchup.h>
 
+u_short swap_wear_probe[FLASH_SWAP_BYTES / FLASH_SECTOR_BYTES];
+
 #ifdef STORAGE_STATS
 static struct storage_stats flstats = {
     .version = STORAGE_STATS_VERSION,
@@ -557,6 +559,13 @@ flash_erase(u_int offset, u_int len)
 	if (!flash_write_admitted(offset, len, flash_write_end))
 		return -1;
 	s = splhigh();
+	if (offset >= FLASH_SWAP_OFFSET) {
+		u_int probe_i;
+
+		for (probe_i = 0; probe_i < len / FLASH_SECTOR_BYTES; probe_i++)
+			swap_wear_probe[(offset - FLASH_SWAP_OFFSET) /
+			    FLASH_SECTOR_BYTES + probe_i]++;
+	}
 	storage_note(offset >= FLASH_SWAP_OFFSET ?
 	    STORAGE_SWAP_ERASE_SECTORS : STORAGE_ROOT_ERASE_SECTORS,
 	    len / FLASH_SECTOR_BYTES);
diff --git a/sys/arch/rp2040/rp2040/sysctl.c b/sys/arch/rp2040/rp2040/sysctl.c
index bcfc8101..60ddff3a 100644
--- a/sys/arch/rp2040/rp2040/sysctl.c
+++ b/sys/arch/rp2040/rp2040/sysctl.c
@@ -236,6 +236,32 @@ cpu_sysctl(int *name, u_int namelen, void *oldp, size_t *oldlenp, void *newp,
 			struct storage_stats stats;
 
 			storage_snapshot(&stats);
+			{
+				extern u_short swap_wear_probe[96];
+				extern struct swap_who_probe {
+					char name[8];
+					u_short ram;
+					u_short flash[13];
+				} swap_who_probe[16];
+				int wi, k;
+
+				printf("\nswapwear");
+				for (wi = 0; wi < 96; wi++)
+					printf("%s%u", wi % 16 ? " " : "\nswapwear ",
+					    swap_wear_probe[wi]);
+				printf("\nswapwear end\n");
+				for (wi = 0; wi < 16; wi++) {
+					if (swap_who_probe[wi].name[0] == 0)
+						continue;
+					printf("swapwho %s ram %u flash",
+					    swap_who_probe[wi].name,
+					    swap_who_probe[wi].ram);
+					for (k = 1; k < 13; k++)
+						printf(" %u", swap_who_probe[wi].flash[k]);
+					printf("\n");
+				}
+				printf("swapwho end\n");
+			}
 			return sysctl_rdstruct(oldp, oldlenp, newp, &stats,
 			    sizeof stats);
 		}
diff --git a/sys/kern/vm_swap.c b/sys/kern/vm_swap.c
index 1d1783f7..41485f40 100644
--- a/sys/kern/vm_swap.c
+++ b/sys/kern/vm_swap.c
@@ -48,6 +48,46 @@ swap_image_span_geometry (size_t data_size, size_t stack_size,
 #endif
 }
 
+/* Measurement probe: swap-outs by command name, flash span and tier. */
+struct swap_who_probe {
+    char    name[8];
+    u_short ram;
+    u_short flash[13];
+} swap_who_probe[16];
+
+static void
+swap_who_note (struct proc *p, size_t span, int ram)
+{
+    const char *comm = ((struct user *) p->p_addr)->u_comm;
+    struct swap_who_probe *w;
+    size_t sectors = span / 4;
+    int i, k;
+
+    if (sectors > 12)
+        sectors = 12;
+    for (i = 0; i < 15; i++) {
+        w = &swap_who_probe[i];
+        if (w->name[0] == 0) {
+            for (k = 0; k < 7 && comm[k]; k++)
+                w->name[k] = comm[k];
+            if (k == 0)
+                w->name[0] = '?';
+            break;
+        }
+        for (k = 0; k < 7 && w->name[k] == comm[k] && comm[k]; k++)
+            ;
+        if (k == 7 || (w->name[k] == 0 && comm[k] == 0))
+            break;
+    }
+    w = &swap_who_probe[i];
+    if (i == 15)
+        w->name[0] = '*';
+    if (ram)
+        w->ram++;
+    else
+        w->flash[sectors]++;
+}
+
 #if defined(STORAGE_STATS) && defined(SWAPRAM) && defined(SWAP_IMAGE_ALIGN)
 /*
  * Admission probe histogram (sys/storage_stats.h): a completed swap-out
@@ -616,6 +656,7 @@ swap_exchange_inplace (struct swap_image_reservation *reservation,
 #ifdef SWAPRAM
     /* Completion is counted once every sector has been transferred. */
     storage_note (STORAGE_SWAPRAM_EXCHANGE_SWAPOUTS, 1);
+    swap_who_note (outgoing, reservation->span, 0);
     SWAP_NOTE_SPAN (STORAGE_SWAPRAM_FLASH_SPAN_01, reservation->span);
 #endif
 
@@ -726,6 +767,11 @@ swap_image_copy_out (struct swap_image_reservation *reservation,
         storage_note (STORAGE_SWAPRAM_FLASH_SWAPOUTS, 1);
         SWAP_NOTE_SPAN (STORAGE_SWAPRAM_FLASH_SPAN_01, reservation->span);
     }
+#endif
+#ifdef SWAPRAM
+    swap_who_note (p, reservation->span, ram);
+#else
+    swap_who_note (p, reservation->span, 0);
 #endif
     reservation->state = SWAP_IMAGE_COPIED;
 }
