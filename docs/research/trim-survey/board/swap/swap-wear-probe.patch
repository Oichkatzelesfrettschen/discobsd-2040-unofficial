+
 void
 boot(dev_t dev __unused, int howto)
 {
 	if ((howto & RB_NOSYNC) == 0 && waittime < 0 &&
 	    bfreelist[0].av_forw != NULL)
 		rp2040_shutdown_sync(howto);
+	{
+		extern u_short swap_wear_probe[96];
+		int probe_i;
+
+		printf("\nswapwear:");
+		for (probe_i = SWAP_WEAR_FIRST; probe_i < SWAP_WEAR_FIRST + 64;
+		    probe_i++)
+			printf("%s%u", (probe_i - SWAP_WEAR_FIRST) % 16 ? " " :
+			    "\nswapwear ", swap_wear_probe[probe_i]);
+		printf("\nswapwear end\n");
+	}
 	(void)splhigh();
