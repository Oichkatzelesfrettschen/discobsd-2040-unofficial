#!/bin/sh
#
# System startup script run by init on autoboot or after single-user.
#
# The Raspberry Pi Pico's root holds 979 kbytes, so this is /etc/rc without
# the motd rewrite, which needs sysctl, sed, cmp, and cp, and without cron.
#
HOME=/; export HOME
PATH=/sbin:/bin:/usr/sbin:/usr/bin; export PATH

exec >/dev/console 2>&1

if test "$1" != "autoboot"; then
    #
    # Switch from single-user to multi-user mode.
    #
    echo
    exit 0
fi

echo "Automatic boot in progress: starting file system checks."
fsck -p
case $? in
0)
    # Filesystems are clean
    ;;
2)
    echo "--- Critical errors detected: run fsck to repair manually"
    exit 1 ;;
4)
    # Root filesystem modified: NO SYNC!
    echo "--- Errors repaired, rebooting..."
    reboot -n ;;
8)
    echo "--- Filesystem check failed... help!"
    exit 1 ;;
12)
    echo "--- Interrupted by user"
    exit 1 ;;
*)
    echo "--- Unknown error in fsck"
    exit 1 ;;
esac

hostname pico
umount -a
mount -a

#
# /tmp on a PicoCalc. A kernel that found a partition of type ba on the SD
# card (sdswapattach() in sys/arch/rp2040/dev/sd.c) names it /dev/sd0t,
# whichever MBR slot holds it, and gives the PSRAM's whole 8 MB to swap, so
# the PSRAM has no /tmp region then. /tmp is disposable, so each boot makes
# a fresh file system on the partition (one inode per 8192 bytes; mkfs
# reads the size from the device) and mounts it over /tmp. Without the
# partition the open fails with ENXIO and the PSRAM case below runs; if
# the partition is present but mkfs or the mount fails, /tmp stays a
# directory of the root and the PSRAM, already all swap, is not used.
#
# The PSRAM, when the kernel found one and no card partition took /tmp,
# holds a 6144 KB RAM disk in minor 1 that every reset empties, so each boot
# makes a fresh file system (one inode per 4096 bytes, 1536 inodes) and
# mounts it over /tmp. A kernel without the driver, or a part that failed
# its probe, fails the open with ENXIO and /tmp stays a directory of the
# root. The read of block 0 decides that before mkfs runs: mkfs creates its
# device with creat(), which truncates, and the kernel rewrites the node's
# inode on the root for the truncation before the driver can refuse the
# open.
#
if test -b /dev/sd0t && dd if=/dev/sd0t of=/dev/null count=1 2>/dev/null; then
    if mkfs -i 8192 /dev/sd0t >/dev/null 2>&1 &&
        mount -o async,noaccesstime,nosuid /dev/sd0t /tmp; then
        chmod 1777 /tmp
    fi
elif test -b /dev/psram1 && dd if=/dev/psram1 of=/dev/null count=1 2>/dev/null &&
    mkfs -i 4096 /dev/psram1 6144 >/dev/null 2>&1 &&
    mount -o async,noaccesstime,nosuid /dev/psram1 /tmp; then
    chmod 1777 /tmp
fi
rm -f /etc/nologin

date
exit 0
