/*
 * One a.out for the three games in games/fifteen, games/keen and
 * games/bubble, dispatched on the name it was invoked by. See
 * sbin/box/box.c.in, whose generated copy this is: each tool's
 * globals are localized and its main renamed by
 * games/gamebox/Makefile, and the sources stay untouched.
 */

#include <string.h>
#include <unistd.h>

@DECLS@

static const struct tool {
	const char	*name;
	int		(*main)(int, char **);
} tools[] = {
@TABLE@
	{ 0, 0 }
};

int
main(int argc, char **argv)
{
	const struct tool *t;
	const char *name, *p;

	name = argv[0];
	for (p = name; *p; p++)
		if (*p == '/')
			name = p + 1;
	if (strcmp(name, "gamebox") == 0 && argc > 1) {
		argc--;
		argv++;
		name = argv[0];
	}
	for (t = tools; t->name; t++)
		if (strcmp(name, t->name) == 0)
			return t->main(argc, argv);
	write(2, "gamebox: no such game\n", 23);
	return 1;
}
