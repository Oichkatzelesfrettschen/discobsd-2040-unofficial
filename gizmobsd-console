#!/bin/sh
#
# Run the DiscoBSD console tools from this checkout without installing
# them: gizmobsd-console up | down | status, and the same for gizmobsd-term,
# gizmobsd-web and gizmobsd-link when this script is invoked under one of
# those names (a symlink or a hard link). The package lives at
# distrib/rp2040/host/src; the only dependency is pyserial
# (${PYTHON} -m pip install --user pyserial). gizmobsd-console launches
# web and link through the interpreter running it, so nothing else needs
# to be on PATH. On Windows the gizmobsd-console.cmd beside this file does
# the same for cmd and PowerShell.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
name=$(basename "$0")
case "$name" in
	discobsd-term|discobsd-web|discobsd-link|discobsd-console) name=gizmobsd-${name#discobsd-} ;;
	gizmobsd-term|gizmobsd-web|gizmobsd-link|gizmobsd-console) ;;
	*) name=gizmobsd-console ;;
esac
module=gizmobsd_host.${name#gizmobsd-}

PYTHONPATH="$here/distrib/rp2040/host/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "${PYTHON:-python3}" -m "$module" "$@"
