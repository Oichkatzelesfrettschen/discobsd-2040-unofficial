# The pack pdp11 boots on the board: the RK kernel as /unix, the shell and
# the tools a session needs, one console, no compiler and no /lib.
/rkunix /unix
/dev
/dev/tty8
/dev/mem
/dev/kmem
/dev/null
b /dev/rk0 0 0
/etc
/etc/init
/etc/getty
/etc/glob
/etc/passwd
/etc/group
/etc/ttys
/etc/utmp
/etc/rc
/etc/update
/bin
/bin/sh
/bin/ls
/bin/cat
/bin/echo
/bin/ed
/bin/cp
/bin/mv
/bin/rm
/bin/ln
/bin/mkdir
/bin/rmdir
/bin/chmod
/bin/chown
/bin/chgrp
/bin/date
/bin/who
/bin/ps
/bin/du
/bin/df
/bin/sort
/bin/uniq
/bin/cmp
/bin/od
/bin/stty
/bin/sync
/bin/kill
/bin/tty
/bin/time
/bin/su
/bin/passwd
/bin/login
/bin/if
/bin/goto
/bin/exit
/tmp
/usr
/usr/tmp
/usr/bin
/usr/bin/wc
/usr/bin/grep
/usr/bin/pwd
/usr/bin/nohup
/usr/bin/cal
/usr/bin/tee
/usr/bin/tr
/usr/games
/usr/games/bj
/usr/games/ttt
/usr/games/moo
