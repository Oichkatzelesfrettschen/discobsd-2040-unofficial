/*
 * One a.out for the usr.bin tools that share the most libc: expr, id,
 * more, uniq, head, tail, tr, wc, cmp, basename, env, printf, tee,
 * touch, xargs, du, tty, uname and md5, dispatched on the name it was
 * invoked by. See sbin/box/box.c.in, whose
 * generated copy this is: each tool's globals are localized and its
 * main renamed by sbin/utilbox/Makefile, and the sources stay
 * untouched. passwd, shutdown, reboot and sysctl stay out; see
 * sys/arch/rp2040/doc/research/utilbox.md.
 */

#include <string.h>
#include <unistd.h>

@DECLS@

static const struct tool {
	const char	*name;
	int		(*main)(int, char **);
} tools[] = {
@TABLE@
	{ 0, 0 }
};

int
main(int argc, char **argv)
{
	const struct tool *t;
	const char *name, *p;

	name = argv[0];
	for (p = name; *p; p++)
		if (*p == '/')
			name = p + 1;
	if ((strcmp(name, "box") == 0 || strcmp(name, "sysbox") == 0 ||
	     strcmp(name, "textbox") == 0 || strcmp(name, "utilbox") == 0) &&
	    argc > 1) {
		argc--;
		argv++;
		name = argv[0];
	}
	for (t = tools; t->name; t++)
		if (strcmp(name, t->name) == 0)
			return t->main(argc, argv);
	write(2, "utilbox: no such tool\n", 23);
	return 1;
}
