#
# The prefix of the arm-none-eabi toolchain, shared by share/mk/sys.mk (the
# programs and libraries), sys/arch/rp2040/conf/compiler.mk (the kernels) and
# distrib/rp2040/Makefile.inc (the board libc). The gcc on PATH wins (Homebrew
# on macOS, or any prefix the developer chose); otherwise the path each
# operating system's package uses. On another host the prefix is
# /does/not/exist, so the first tool invocation names the missing toolchain
# instead of running whatever a guessed path holds.

.if !defined(_HOST_OSNAME)
_HOST_OSNAME!=	uname -s
.endif

ARM_TOOLCHAIN_PREFIX!=if command -v arm-none-eabi-gcc >/dev/null 2>&1 ; then \
			echo "$$(command -v arm-none-eabi-gcc | sed 's/-gcc$$//')" ; \
		elif [ x"${_HOST_OSNAME}" = x"OpenBSD" ] ; then \
			echo "/usr/local/bin/arm-none-eabi" ; \
		elif [ x"${_HOST_OSNAME}" = x"FreeBSD" ] ; then \
			echo "/usr/local/gcc-arm-embedded/bin/arm-none-eabi" ; \
		elif [ x"${_HOST_OSNAME}" = x"Linux" ] ; then \
			echo "/usr/bin/arm-none-eabi" ; \
		else \
			echo "/does/not/exist" ; \
		fi
