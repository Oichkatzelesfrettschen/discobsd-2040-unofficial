# ClockworkPi PicoCalc (mainboard V2.0) with a Raspberry Pi Pico
# ===============================================================
#
# To build the kernel, use:
#   cd sys/arch/rp2040/compile/PICOCALC
#   tools/bin/config Config
#   make clean
#   make
#
# sys/arch/rp2040/doc/PICOCALC.md maps the board's pins and states what
# each driver has and has not been observed doing on the hardware.
#
architecture    "rp2040"
cpu             "RP2040"                    # Processor variant
board           "PICOCALC"                  # Board type
ldscript        "RP2040.ld"                 # Kernel memory linker script

makeoptions     DEBUG="-g"                  # Debug symbols

# Standard system options
options         "CPU_KHZ=125000"            # clk_sys after PLL bring-up
options         "BUS_KHZ=125000"            # clk_peri runs from clk_sys
options         "HALTREBOOT"                # If halted, press key to reboot
options         SYSTRACE                    # kern.systrace console trace
options         CAPACITY_STATS              # fixed-table and u-area peaks

# Root filesystem at /dev/fl0a, swap on /dev/fl1, the same layout as the
# PICO board: the Pico module's own QSPI flash. The SD socket on SPI0 is
# sd0 (see PICOCALC.md); a UFS partition on it mounts beside the root.
config          unix    root on fl0a
                        swap on fl1
                        dumps on none          # Never the live swap; sdprobe() arms the SD card (sys/arch/rp2040/include/dump.h).

options         "NFL=2"                     # fl0 root, fl1 swap.
options         "NMOUNT=2"                  # The flash root and one SD partition.
options         LINEAR_INODE_CACHE           # Scan 24 entries; omit hash links.
options         COMPACT_INODE_FIELDS         # Four bounded fields use 16 bits.
options         COMPACT_SWAPMAP              # 16-bit entries cover 384 blocks.
options         LINEAR_BUFFER_CACHE          # Scan four buffers; omit hash links.
options         LINEAR_NAME_CACHE            # Scan four names; use second chance.
options         "CORE_DEFAULT=0"            # No core dumps unless raised.
options         "ROOT_MOUNT_FLAGS=MNT_NOATIME" # Reads do not dirty root inodes.

# Console on the board's own panel and keyboard: the ST7365P on SPI1 and
# the keyboard controller on I2C1, /dev/console as a 53x32 xterm-basic
# terminal.
device          picocalc
options         "CONS_MAJOR=LCDCONS_MAJOR"  # panel and keyboard
options         "CONS_MINOR=0"

# The SD card socket: SPI0 on GP16-GP19, card detect on GP22. A multi-mount
# kernel keeps each inode's device and filesystem fields, so
# SINGLE_UFS_ROOT (which needs NMOUNT=1) is not set.
device          sd

# The USB-C port reaches UART0 on GP0 and GP1 through a CH340C bridge
# while DIP switch SW701 is in its default position; it is /dev/tty0.
device          uart0
options         "UART_BAUD=115200"          # default speed

# The Pico's own micro-USB port as a CDC-ACM device, /dev/ttyUSB0; it also
# carries the reset interface picotool reboot -u uses.
device          uartusb

# Compressed RAM tier in front of the flash swap and packed executables,
# as on the PICO board.
options        SWAPRAM                     # RAM tier ahead of fl1
options        "SWAPRAM_KB=16"             # kbytes of bss for the pool
options        EXEC_HSAOUT                 # packed a.out executables
