# Full PicoCalc with a required SD root and a 160 KiB kernel reservation.
# check_generated_sync.py compares every directive to the full PICOCALC
# configuration, apart from the linker script, the root, SYSTRACE,
# LCD_PANELTEST, LCD_GFX_EXT and LCD_VT: the syscall trace, the panel
# register test (sys/arch/rp2040/doc/PANELTEST.md), the extended /dev/lcdgfx
# commands (sys/sys/lcdgfx.h) and the second console ttyv1
# (sys/arch/rp2040/dev/lcdcons.c), which the 128 KiB kernel leaves out for
# room. The SD service resolves the first type-b7 partition
# before root mount. Raw flash swap retains its standard location.
architecture    "rp2040"
cpu             "RP2040"
board           "PICOCALC_SD"
ldscript        "RP2040-sd.ld"
makeoptions     DEBUG="-g"
options         "CPU_KHZ=125000"
options         "BUS_KHZ=125000"
options         "HALTREBOOT"
options         SYSTRACE
options         CAPACITY_STATS
options         LCD_PANELTEST
options         LCD_GFX_EXT
options         LCD_VT
options         LCD_BLANK
config          unix    root on sd0a
                        swap on fl1
                        dumps on none
options         "NPROC=32"
options         "MAXUPRC=25"
options         "SMAPSIZ=36"
options         "NFL=2"
options         "NMOUNT=3"
options         LINEAR_INODE_CACHE
options         COMPACT_INODE_FIELDS
options         COMPACT_SWAPMAP
options         LINEAR_BUFFER_CACHE
options         LINEAR_NAME_CACHE
options         "CORE_DEFAULT=0"
options         "ROOT_MOUNT_FLAGS=MNT_NOATIME"
device          picocalc
options         "CONS_MAJOR=LCDCONS_MAJOR"
options         "CONS_MINOR=0"
device          psram
device          sd
service         sdroot
service         sdswap
device          uart0
options         "UART_BAUD=115200"
options         "NUART=1"
device          uartusb
options         "USB_TXRING=4096"
options        SWAPRAM
options        "SWAPRAM_KB=16"
options        EXEC_HSAOUT
options         DEV_ADC
options         DEV_GPIO
options         DEV_GPIO_PWM
options         DEV_LCDGFX
options         DEV_PCM
