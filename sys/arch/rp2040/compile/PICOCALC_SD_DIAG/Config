# ClockworkPi PicoCalc (mainboard V2.0) with a Raspberry Pi Pico and a
# required SD root: PICOCALC_SD as the testing kernel, with DIAGNOSTIC,
# GLOBAL_DEBUG=9 and STORAGE_STATS added and compiled at -Og so that a debugger follows
# source lines and keeps locals. A board line defines only its own name and
# the sources test -DPICOCALC_SD (dev/flash.h, dev/sd.c, dev/uart.c), so
# options PICOCALC_SD defines it here. check_generated_sync.py compares every
# directive to PICOCALC_SD apart from those additions. The shipped PICOCALC_SD
# kernel stays at -Os. kern.systrace bit 2 prints the signal deliveries
# (rp2040/sig_machdep.c) and bit 4 the GLOBAL_DEBUG trace of every execve(2),
# both off at boot; PICOCALC.md carries the sizes. CONSOLE_MIRROR_UART (sys/dev/cons.c) sends every console
# character to UART0 as well, so a host records what the panel scrolls away.
architecture    "rp2040"
cpu             "RP2040"
board           "PICOCALC_SD_DIAG"
ldscript        "RP2040-sd.ld"
makeoptions     DEBUG="-g"
makeoptions     COPTS="-Og"
options         "CPU_KHZ=125000"
options         "BUS_KHZ=125000"
options         "HALTREBOOT"
options         SYSTRACE
options         CAPACITY_STATS
options         PICOCALC_SD
options         DIAGNOSTIC
options         "GLOBAL_DEBUG=9"
options         STORAGE_STATS
options         CONSOLE_MIRROR_UART
options         LCD_PANELTEST
options         LCD_GFX_EXT
options         LCD_VT
config          unix    root on sd0a
                        swap on fl1
                        dumps on none
options         "NPROC=32"
options         "MAXUPRC=25"
options         "SMAPSIZ=36"
options         "NFL=2"
options         "NMOUNT=3"
options         LINEAR_INODE_CACHE
options         COMPACT_INODE_FIELDS
options         COMPACT_SWAPMAP
options         LINEAR_BUFFER_CACHE
options         LINEAR_NAME_CACHE
options         "CORE_DEFAULT=0"
options         "ROOT_MOUNT_FLAGS=MNT_NOATIME"
device          picocalc
options         "CONS_MAJOR=LCDCONS_MAJOR"
options         "CONS_MINOR=0"
device          psram
device          sd
service         sdroot
service         sdswap
device          uart0
options         "UART_BAUD=115200"
options         "NUART=1"
device          uartusb
options         "USB_TXRING=4096"
options        SWAPRAM
options        "SWAPRAM_KB=16"
options        EXEC_HSAOUT
options         DEV_ADC
options         DEV_GPIO
options         DEV_GPIO_PWM
options         DEV_LCDGFX
options         DEV_PCM
