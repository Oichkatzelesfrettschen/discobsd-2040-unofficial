# Raspberry Pi Pico board, diagnostics
# ====================================
#
# The PICO kernel plus the options that gather diagnostic evidence: the
# syscall and signal trace (SYSTRACE, kern.systrace and kern.systracepid)
# and the fixed-table and u-area accounting (CAPACITY_STATS, kern.capacity).
# PICO omits both, so its sysctl answers EOPNOTSUPP for those nodes and it
# links no system call name table. This Config and PICO's differ in the
# board line and those additions only; the generated sync gate
# (tools/config/check_generated_sync.py) holds them to that. The board name
# is this directory's name, so PARAM defines -DPICO_DIAG, and
# sys/arch/rp2040/rp2040/board.c compiles PICO's bare-Pico USB console
# descriptor into it.
#
# To build the kernel, use:
#   cd sys/arch/rp2040/compile/PICO_DIAG
#   tools/bin/config Config
#   make clean
#   make
#
architecture    "rp2040"
cpu             "RP2040"                    # Processor variant
board           "PICO_DIAG"                 # Board type
ldscript        "RP2040.ld"                 # Kernel memory linker script

makeoptions     DEBUG="-g"                  # Debug symbols

# Standard system options
options         "CPU_KHZ=125000"            # clk_sys after PLL bring-up
options         "BUS_KHZ=125000"            # clk_peri runs from clk_sys
options         "HALTREBOOT"                # If halted, press key to reboot
options         SYSTRACE                    # kern.systrace console trace
options         CAPACITY_STATS              # fixed-table and u-area peaks

options         "CORE1"                     # core 1 observes core 0's clock

# Root filesystem at /dev/fl0a, swap on /dev/fl1.
# The RP2040 has no SD controller and this board has no socket, so root
# lives on the onboard QSPI flash behind a translation layer, and swap in
# a raw region above it; see arch/rp2040/dev/flash.c.
config          unix    root on fl0a
                        swap on fl1
                        dumps on none          # A dump would overwrite the live swap; sys/arch/rp2040/include/dump.h.

options         "NFL=2"                     # fl0 root, fl1 swap.
options         "NMOUNT=1"                  # One UFS root; fl1 is raw swap.
options         SINGLE_UFS_ROOT             # Derive inode and root mount identity.
options         LINEAR_INODE_CACHE           # Scan 24 entries; omit hash links.
options         COMPACT_INODE_FIELDS         # Four bounded fields use 16 bits.
options         COMPACT_SWAPMAP              # 16-bit entries cover 384 blocks.
options         LINEAR_BUFFER_CACHE          # Scan four buffers; omit hash links.
options         LINEAR_NAME_CACHE            # Scan four names; use second chance.
options         "CORE_DEFAULT=0"            # No core dumps unless raised.
options         "ROOT_MOUNT_FLAGS=MNT_NOATIME" # Reads do not dirty root inodes.

# Console over the board's USB cable: a CDC-ACM device on the RP2040's own
# controller, /dev/ttyACM0 on a Linux host. It also carries the Pico SDK's
# reset interface, so picotool reboot -u returns the board to BOOTSEL.
device          uartusb
options         "CONS_MAJOR=UARTUSB_MAJOR"  # USB device
options         "CONS_MINOR=0"              # /dev/ttyUSB0

# UART0 on GP0 and GP1 stays available as /dev/tty0 for a serial adapter.
device          uart0
options         "UART_BAUD=115200"          # default speed

# The Pico carries a single LED, wired to GP25. There is no choice of pin to
# record here, so machdep.c names it directly and led_control lights the same
# one for every activity class.

# Compressed RAM tier in front of the flash swap, off by default. Enabling
# both lines below costs 4,148 bytes of text and SWAPRAM_KB kilobytes plus
# about 3,200 bytes of bss; see doc/research/zswap.md for the measurements
# and the board test sequence. 16 KB holds about three shell-sized images
# at their counted size; the 48 KB a 64 KB pool used to take went to the
# user window in conf/RP2040.ld instead.
options        SWAPRAM                     # RAM tier ahead of fl1
options        "SWAPRAM_KB=16"             # kbytes of bss for the pool
options        EXEC_HSAOUT                 # packed a.out executables

# On-chip and board peripherals, one line per driver.
options         DEV_ADC                     # RP2040 ADC: temperature and VSYS sysctls
