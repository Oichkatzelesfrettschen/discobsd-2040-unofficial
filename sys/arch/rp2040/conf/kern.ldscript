/*
 * Kernel common linker script for RP2040.
 */

/*
 * On STM32, a minimum of 128 kbytes of flash and 128 kbytes of RAM is needed.
 * Reserve for the kernel at least 128 kbytes of flash and 32 kbytes of RAM.
 * Reserve for userland at least 96 kbytes of RAM.
 */

__kernel_flash_start	= ORIGIN(FLASH);
__kernel_flash_end	= ORIGIN(FLASH) + LENGTH(FLASH);
__kernel_data_start	= ORIGIN(RAM);
__kernel_data_end	= ORIGIN(RAM) + LENGTH(RAM);
__user_data_start	= ORIGIN(USERRAM);
__user_data_end		= ORIGIN(USERRAM) + LENGTH(USERRAM);

u0			= ORIGIN(U0AREA);
u			= ORIGIN(UAREA);
u_end			= ORIGIN(UAREA) + LENGTH(UAREA);
_estack			= ORIGIN(UAREA) + LENGTH(UAREA);

ENTRY(Reset_Handler)

PHDRS {
	boot2 PT_LOAD FLAGS(5);
	flash PT_LOAD FLAGS(5);
	data PT_LOAD FLAGS(6);
	ramfunc PT_LOAD FLAGS(5);
	bss PT_LOAD FLAGS(6);
	scratch PT_LOAD FLAGS(6);
	stack PT_GNU_STACK FLAGS(6);
}

SECTIONS {
	/*
	 * The 256-byte second stage the boot ROM loads from flash offset 0,
	 * padded and CRC32-trailed by tools/boot2sum. Placing it here makes
	 * the objcopy binary of the kernel a complete flash image from
	 * 0x10000000, with the vector table at 0x10000100 where boot2's exit
	 * routine expects it.
	 */
	.boot2 : {
		KEEP(*(.boot2))
	} > BOOT2 :boot2

	.text : {
		KEEP(*(.isr_vector))
		. = ALIGN(8);
		*(.text*)
		. = ALIGN(8);
		*(.rodata*)
	} > FLASH :flash

	.ARM.extab : {
		*(.ARM.extab* .gnu.linkonce.armextab.*)
	} > FLASH :flash

	.ARM.exidx : {
		__exidx_start = .;
		*(.ARM.exidx* .gnu.linkonce.armexidx.*)
		__exidx_end = .;
	} > FLASH :flash
	/*
	 * The .data initializers are copied by whole words in locore0.S, and
	 * ARMv6-M faults on an unaligned word load, before any handler can
	 * exist. The load address must therefore be aligned, and _sidata
	 * must be that address rather than the raw location counter, which
	 * ends wherever .ARM.exidx does.
	 */
	. = ALIGN(4);
	__etext = .;

	_sidata = LOADADDR(.data);
	.data : ALIGN(4) {
		__data_start__ = .;
		_sdata = .;
		*(.data*)
		. = ALIGN(8);
	} > RAM AT > FLASH :data

	.ramfunc : AT(LOADADDR(.data) + SIZEOF(.data)) {
		/*
		 * Code that must not execute from flash. Every flash erase or
		 * program on the RP2040 takes the QSPI interface out of
		 * execute-in-place for its duration, so a function driving one
		 * cannot be fetched from flash while it runs. Placing it inside
		 * .data puts it in RAM and lets the existing copy loop in
		 * locore0.S carry it there, with no second mechanism.
		 */
		__ramfunc_start__ = .;
		*(.ramfunc*)
		. = ALIGN(8);
		__ramfunc_end__ = .;
		__data_end__ = .;
		_edata = .;
	} > RAM :ramfunc

	.bss : {
		. = ALIGN(8);
		__bss_start__ = .;
		_sbss = .;
		*(.bss*)
		*(COMMON)
		. = ALIGN(8);
		__bss_end__ = .;
		_ebss = .;
	} > RAM :bss

	/*
	 * Storage in the scratch banks, see SCRATCH in RP2040.ld. NOLOAD
	 * keeps it out of the flash image and out of the .data copy, and
	 * locore0.S's zero-fill loops stop at _ebss, so a variable here
	 * starts with whatever the banks held and its owner must write
	 * every byte before reading it. The assertion pins the USB ring to
	 * the banks whenever the kernel carries it; a kernel configured
	 * without uartusb defines no such symbol, and the conditional
	 * keeps ld from evaluating the reference in that case, which it
	 * would do inside a plain || and reject as undefined.
	 */
	.scratch (NOLOAD) : {
		. = ALIGN(4);
		__scratch_start__ = .;
		*(.scratch*)
		. = ALIGN(4);
		__scratch_end__ = .;
	} > SCRATCH :scratch
	/*
	 * The SRAM regions of RP2040.ld are edited as a set: the user window
	 * ends where the kernel data begins, the kernel data ends at the
	 * process 0 u area, that at the current u area, and that at the
	 * scratch banks. A gap would idle memory and an overlap would let two
	 * regions share bytes, so both are refused at link time.
	 */
	ASSERT(ORIGIN(USERRAM) + LENGTH(USERRAM) == ORIGIN(RAM),
	    "USERRAM and RAM do not meet")
	ASSERT(ORIGIN(RAM) + LENGTH(RAM) == ORIGIN(U0AREA),
	    "RAM and U0AREA do not meet")
	ASSERT(ORIGIN(U0AREA) + LENGTH(U0AREA) == ORIGIN(UAREA),
	    "U0AREA and UAREA do not meet")
	ASSERT(ORIGIN(UAREA) + LENGTH(UAREA) == ORIGIN(SCRATCH),
	    "UAREA and SCRATCH do not meet")
	ASSERT(DEFINED(usb_tx_ring) ?
	    (usb_tx_ring >= ORIGIN(SCRATCH) &&
	     usb_tx_ring + 8192 <= ORIGIN(SCRATCH) + LENGTH(SCRATCH)) : 1,
	    "usb_tx_ring is not inside the SRAM4/SRAM5 scratch banks")
}
