set -eu
umask 077
work=/tmp/confcheck.$$
mkdir "$work"
cd "$work"
trap 'rc=$?; cd / && rm -f "$work"/[0-9] "$work"/out "$work"/err "$work"/want && rmdir "$work"; exit "$rc"' 0

check_value()
{
	expected=$1
	shift
	printf '%s\n' "$expected" >want
	/usr/bin/getconf "$@" >out 2>err
	cmp want out
	test ! -s err || exit 1
}

check_value 5120 ARG_MAX
check_value 16 NGROUPS_MAX
check_value 30 OPEN_MAX
check_value 1 _POSIX_JOB_CONTROL
check_value 1 NPROCESSORS_CONF
check_value 1 NPROCESSORS_ONLN
check_value 1024 PAGESIZE
check_value 1024 PAGE_SIZE
check_value 8 -- SYMLOOP_MAX
check_value undefined _POSIX_DEVICE_CONTROL
check_value /usr/bin:/bin:/usr/sbin:/sbin PATH
check_error()
{
	if /usr/bin/getconf "$@" >out 2>err; then exit 1; fi
	test ! -s out || exit 1
	test -s err || exit 1
}

check_error UNKNOWN
if /usr/bin/getconf >out 2>err; then exit 1; fi
test ! -s out || exit 1
test -s err || exit 1
check_error OPEN_MAX extra

echo payload >0
previous=0
for next in 1 2 3 4 5 6 7 8 9; do
	ln -s "$previous" "$next"
	previous=$next
done
cat 8 >out
cmp 0 out
if cat 9 >out 2>err; then exit 1; fi
test ! -s out || exit 1
grep 'Too many levels of symbolic links' err >/dev/null
echo confcheck-pass
