#
# Transcript tests of the uLisp interpreter (usr.bin/ulisp).
#
#   check         the host build over the language, system, images, repairs,
#                 arith, conformance, types and devices corpora (arith is generated by
#                 gen-arith.py: every integer builtin at the edges of a
#                 32-bit integer; types by gen-types.py: every builtin with
#                 one argument at a time replaced by an object of each kind a
#                 caller can pass) and, on Linux, the race corpus, which
#                 rewrites or truncates an image between the loader's two
#                 reads (rewrite-race.c); the same corpora with the address and
#                 undefined-behavior sanitizers, which turn an overflow, an
#                 out-of-range access or a misaligned pointer into a failure;
#                 hilite-test, the classes of hilite.c on a table of lines,
#                 also with the sanitizers; hilite-pty.py, the interpreter on
#                 a pseudo-terminal, which checks the colors of the builtin
#                 table and the repaint; then the mutants of ulisp.c and
#                 hilite.c that the check must reject (mutants.sh)
#   check-qemu    the a.out the tree links, run by tests/qemu_aout/aoutrun
#                 under qemu-arm: the language, system, images, repairs and
#                 conformance corpora against the same expected transcripts as
#                 the host, and the
#                 stack and machine-code corpora that need the target, and
#                 the workspace floor (ULISP_FLOOR cells at the first prompt)
#   check-oracle  the language corpus through the unmodified upstream source
#                 built for the host (oracle/), compared with the host build;
#                 ULISP_INO names ulisp-picocalc.ino, which is not in the tree
#
# The expected transcripts are the interpreter's own output: language.expected
# is the one check-oracle holds to the upstream program, repairs.lisp
# holds the forms whose output differs from upstream on purpose, and
# conformance.lisp holds cases cited to sections of the Common Lisp HyperSpec.
TOPSRC!=cd ../..; pwd
include ${TOPSRC}/share/mk/sys.mk
include ${TOPSRC}/tools/qemu-arm.mk

SRC=		${TOPSRC}/usr.bin/ulisp
LOADER=		${TOPSRC}/tests/qemu_aout
# qemu-arm accepts a guest at address 0 only with a guest base (-B).
GUEST_BASE?=	0x100000
# The workspace the program leaves at its first prompt under qemu-arm with an
# empty environment: what is left of the process window after the program's
# bytes, 8 bytes a cell.
ULISP_FLOOR?=	14000
ORACLE_SHA256=	65608bb7d6a48dc02dd38f67d10a826bc7a60456e106c4b7212a2dd0483ebd8b
ORACLE_CXX?=	g++ -m32 -msse2 -mfpmath=sse
HOST_SRCS=	${SRC}/ulisp.c ${SRC}/unix.c ${SRC}/hilite.c ${SRC}/gfx.c ${SRC}/dev_host.c \
		${TOPSRC}/sys/arch/rp2040/dev/lcdfont.c
SANITIZE=	-fsanitize=address,undefined,float-cast-overflow -fno-sanitize-recover=all \
		-fno-omit-frame-pointer

all: check

check:
	${MAKE} -C ${SRC} ulisp.host ulisp.doc
	shim=; \
	if [ "$$(uname -s)" = Linux ]; then \
		${HOST_CC} -std=gnu17 -Wall -Wextra -Werror -shared -fPIC \
		    -o rewrite-race.so ${.CURDIR}/rewrite-race.c -ldl && \
		shim=${.CURDIR}/rewrite-race.so; \
	else \
		echo "SKIP ulisp rewrite race: the shim needs Linux LD_PRELOAD; no execution occurred"; \
	fi; \
	ULISP_REWRITE_SHIM=$$shim sh check.sh host ${SRC}/ulisp.doc ${SRC}/ulisp.host
	${HOST_CC} -std=c17 -D_DEFAULT_SOURCE -O1 -g ${SANITIZE} \
	    -I${TOPSRC}/sys/arch/rp2040/dev -o ulisp.san ${HOST_SRCS} -lm
	sh check.sh host ${SRC}/ulisp.doc env ASAN_OPTIONS=detect_leaks=0 \
	    ${.CURDIR}/ulisp.san
	${HOST_CC} -std=c17 -Wall -Wextra -Werror -D_DEFAULT_SOURCE -I${SRC} \
	    -o hilite-test hilite-test.c ${SRC}/hilite.c
	./hilite-test
	${HOST_CC} -std=c17 -D_DEFAULT_SOURCE -O1 -g ${SANITIZE} -I${SRC} \
	    -o hilite-test.san hilite-test.c ${SRC}/hilite.c
	ASAN_OPTIONS=detect_leaks=0 ./hilite-test.san
	${PYTHON} -I hilite-pty.py ${SRC}/ulisp.host ${SRC}/ulisp.doc
	sh mutants.sh ${SRC} ${SRC}/ulisp.doc "${HOST_CC}"

check-qemu:
.if empty(QEMU_ARM) && !empty(REQUIRE_QEMU)
	@echo "ulisp qemu: qemu-arm unavailable and REQUIRE_QEMU is set" >&2; exit 1
.elif empty(QEMU_ARM)
	@echo "SKIP ulisp qemu: qemu-arm unavailable; no ARM execution occurred"
.else
	${MAKE} -C ${SRC} ulisp ulisp.doc
	${MAKE} -C ${LOADER} aoutrun
	${OBJDUMP} -d ${SRC}/ulisp.elf | \
	    awk '/\tsvc\t/ { sub(":", "", $$1); print $$1 }' | sort > ulisp.sites
	sh check.sh qemu ${SRC}/ulisp.doc ${QEMU_ARM} -B ${GUEST_BASE} \
	    -cpu ${QEMU_ARM_CPU} ${LOADER}/aoutrun ${.CURDIR}/ulisp.sites \
	    ${SRC}/ulisp
	@cells=$$(env -i ${QEMU_ARM} -B ${GUEST_BASE} -cpu ${QEMU_ARM_CPU} \
	    ${LOADER}/aoutrun ${.CURDIR}/ulisp.sites ${SRC}/ulisp < /dev/null | \
	    awk '/^[0-9]+> / { sub(">.*", ""); print; exit }'); \
	if [ -z "$$cells" ] || [ "$$cells" -lt ${ULISP_FLOOR} ]; then \
		echo "ulisp qemu: the first prompt reports '$$cells' workspace cells, below the floor ${ULISP_FLOOR}" >&2; \
		exit 1; \
	fi; \
	echo "ulisp qemu: $$cells workspace cells at the first prompt (floor ${ULISP_FLOOR})"
.endif

# The upstream program reads its workspace size from its board table: 22280
# cells for the Pico. Its last prompt has no newline, so one is added.
check-oracle:
.if empty(ULISP_INO)
	@echo "SKIP ulisp oracle: ULISP_INO does not name ulisp-picocalc.ino"
.else
	${MAKE} -C ${SRC} ulisp.host ulisp.doc
	${PYTHON} -I oracle/mkoracle.py ${ULISP_INO} ${ORACLE_SHA256} oracle.cc
	${ORACLE_CXX} -std=gnu++17 -O1 -fpermissive -w -Ioracle -o oracle.bin \
	    oracle.cc -lm
	(./oracle.bin < language.lisp; echo) | tr -d '\r' > oracle.out
	ULISPDOC=${SRC}/ulisp.doc ${SRC}/ulisp.host -w 22280 < language.lisp \
	    > oracle.host
	diff oracle.out oracle.host
	@echo "ulisp oracle: the language transcript matches the upstream program"
.endif

clean:
	rm -f ulisp.san hilite-test hilite-test.san ulisp.sites rewrite-race.so oracle.cc oracle.bin oracle.out oracle.host

.PHONY: all check check-qemu check-oracle clean
