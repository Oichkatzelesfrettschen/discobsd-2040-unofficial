(defun pretty (x)
  (if (> x 0)
    (let ((y (* x x))) (format t "~a~%" y) y)
    (progn (print x) nil)))

11773> 

(defun documented (x) "Doubles x." (* 2 x))

(defun outer nil (inner))

(defun inner nil (car 1))

(defun deep (n)
  (if (= n 0) 0 (+ 1 (deep (- n 1)))))

(defvar *c* '(closure ((n . 3)) nil (incf n)))

(defun make-counter nil
  (let ((n 0)) (lambda nil (incf n))))

(defun rst (a &rest more) (list a more))

(defun opt (a &optional (b 5) c) (list a b c))

(defun tail (n acc)
  (if (= n 0) acc (tail (- n 1) (+ acc 1))))

(defun fib (n)
  (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(defun fact (n)
  (if (<= n 1) 1 (* n (fact (- n 1)))))

(defvar *v* '10)

