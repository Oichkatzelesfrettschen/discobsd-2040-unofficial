+
+static int
+v7fs_directory_add_checked(struct v7fs_self *fs, struct v7fs_inode *parent_dir,
+    v7fs_ino_t ino, const char *srcname, size_t srclen, bool *unpublished)
+{
+	struct v7fs_inode inode;
+	struct v7fs_dirent *dir, original;
+	v7fs_daddr_t block;
+	void *buffer;
+	char filename[V7FS_NAME_MAX + 1];
+	size_t old_size = parent_dir->filesize, size;
+	int error, cleanup_error, slot;
+
+	*unpublished = true;
+	v7fs_dirent_filename(filename, srcname, srclen);
+	if ((error = v7fs_inode_load(fs, &inode, ino)) != 0)
+		return error;
+	if ((error = v7fs_datablock_expand(fs, parent_dir, sizeof(*dir))) != 0)
+		return error;
+	block = v7fs_datablock_last(fs, parent_dir, parent_dir->filesize);
+	if (block == 0 || !(buffer = scratch_read(fs, block))) {
+		error = EIO;
+		goto rollback_parent;
+	}
+	size = V7FS_RESIDUE_BSIZE(parent_dir->filesize);
+	slot = size / sizeof(*dir) - 1;
+	dir = buffer;
+	original = dir[slot];
+	dir[slot].inode_number = V7FS_VAL16(fs, ino);
+	memcpy((char *)dir[slot].name, filename, V7FS_NAME_MAX);
+	*unpublished = false;
+	if (!fs->io.write(fs->io.cookie, buffer, block)) {
+		error = EIO;
+		goto restore_entry;
+	}
+	if (v7fs_inode_isdir(&inode)) {
+		parent_dir->nlink++;
+		error = v7fs_inode_writeback(fs, parent_dir);
+		if (error != 0) {
+			parent_dir->nlink--;
+			goto restore_entry;
+		}
+	}
+	scratch_free(fs, buffer);
 	return 0;
+
+restore_entry:
+	dir[slot] = original;
+	*unpublished = fs->io.write(fs->io.cookie, buffer, block);
+	scratch_free(fs, buffer);
+	if (!*unpublished)
+		return error;
+rollback_parent:
+	cleanup_error = v7fs_datablock_contract(fs, parent_dir,
+	    parent_dir->filesize - old_size);
+	return cleanup_error != 0 ? cleanup_error : error;
 }
 
