+static int
+v7fs_discard_new_inode(struct v7fs_self *fs, struct v7fs_inode *inode)
+{
+	int error;
+	unsigned index;
+
+	if (v7fs_inode_isdir(inode)) {
+		if (inode->filesize != 0 &&
+		    (error = v7fs_datablock_contract(fs, inode, inode->filesize)) != 0)
+			return error;
+		for (index = 0; index < V7FS_NADDR; index++)
+			if (inode->addr[index] != 0)
+				return EIO;
+	}
+	return v7fs_inode_deallocate(fs, inode->inode_number);
+}
 
