# Boot the DiscoBSD RP2040 kernel under Renode, from the real boot ROM, with
# a console to type at and a GDB server to attach to.
#
# machine.resc beside this file builds the machine and stops there; everything
# below is the interactive part. tools/renode/boot.robot includes that same
# machine.resc and attaches a terminal tester instead, so the machine a person
# debugs and the machine the gate asserts on are one machine.
#
# Nothing shortcuts into the kernel's vector table the way Renode_RP2040's
# run_firmware.resc does for bare pico-examples binaries: the CPU resets into
# the genuine boot ROM, which reads the 256-byte boot2 image at flash offset
# 0, checks its CRC32, copies it to SRAM and jumps to it with lr = 0. boot2
# (sys/arch/rp2040/boot2/boot2_w25q080.S, linked at the start of unix.bin)
# configures the SSI for XIP and vectors into the kernel at 0x10000100, and
# every rom_func_lookup() in sys/arch/rp2040/dev/flash.c walks that same ROM's
# real function table.
#
# Usage, from a built tree:
#   renode --disable-gui -e "include @tools/renode/boot.resc"
# or with different images:
#   renode -e "\$unix_bin=@/path/unix.bin; \$flash_bin=@/path/flash.bin; include @boot.resc"
#
# The kernel does not reach a login prompt here. Renode's SSI model shares its
# FIFOs between the CPU thread and its own clocking thread without a lock and
# eventually loses a byte, after which the boot ROM waits under splhigh() for
# data that will not arrive. sys/arch/rp2040/doc/research/emulation.md has the
# measurements and a diff that clears it.

$uart_port ?= 3456
$gdb_port ?= 3333

include $ORIGIN/machine.resc

# UART0 (GP0/GP1, the PICO_UART console) on a TCP socket a plain client can
# attach to: `nc localhost 3456`, or the console.py helper beside this file,
# which also timestamps and logs every line.
emulation CreateServerSocketTerminal $uart_port "uart0term" false
connector Connect sysbus.uart0 uart0term

machine StartGdbServer $gdb_port

start

echo "rp2040_discobsd: UART0 on tcp://localhost/$uart_port, GDB on tcp://localhost/$gdb_port"
