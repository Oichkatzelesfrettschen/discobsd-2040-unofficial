 using Antmicro.Renode.Core.Structure.Registers;
 using Antmicro.Renode.Utilities.Collections;
 using Antmicro.Renode.Peripherals.GPIOPort;
 using Antmicro.Renode.Peripherals.Miscellaneous;
+using Antmicro.Renode.Time;
+using Antmicro.Renode.Peripherals.Timers;
 
 namespace Antmicro.Renode.Peripherals.SPI
 {
@@ -32,6 +35,8 @@
     public PL022(IMachine machine, RP2040GPIO gpio, int id, RP2040Clocks clocks, ulong address) : base(machine)
     {
       this.id = id;
+      frameTimer = new LimitTimer(machine.ClockSource, 1000000000, this, "SSPFRAME", direction: Direction.Ascending, enabled: false, workMode: WorkMode.OneShot, eventEnabled: true, autoUpdate: true);
+      frameTimer.LimitReached += FrameDone;
       this.gpio = gpio;
       this.clocks = clocks;
       txPins = new HashSet<int>();
@@ -106,6 +111,7 @@
       {
         newFrequency = 1;
       }
+      bitRate = newFrequency;
       if (newFrequency != this._executionThread.Frequency)
       {
         this._executionThread.Frequency = newFrequency;
@@ -224,6 +230,85 @@
       return false;
     }
 
+    // With an ISPIPeripheral registered under this controller, a frame
+    // written to SSPDR goes to that device as bytes, most significant
+    // first, and its reply lands in the receive FIFO at once. The controller
+    // stays busy for the time the frame occupies the wire at the programmed
+    // bit rate, so a driver that waits on BSY sees the same durations as on
+    // silicon. Without a registered device the controller clocks the frame
+    // out on the GPIO pins, bit by bit, as before.
+    //
+    // The frames still on the wire stand in for the transmit FIFO and the
+    // shift register: the oldest is being shifted, and the others wait in
+    // the FIFO, which holds eight entries (PL022 TNF and TFE derive from
+    // that level). A frame written while the FIFO is full is discarded, as
+    // the data register discards it on silicon, so a driver that skips the
+    // TNF wait loses frames here too. A clock-source timer ends each frame
+    // at its exact virtual time: the machine clock otherwise advances in
+    // quanta far longer than a frame, and a driver polling TNF would see the
+    // FIFO drain only once per quantum.
+    private void TransferFrame(ISPIPeripheral device, ushort frame)
+    {
+      if (FrameFifoLevel() >= txBuffer.Capacity)
+      {
+        return;
+      }
+      ushort reply = 0;
+      if (loopbackMode)
+      {
+        reply = frame;
+      }
+      else if (dataSize > 8)
+      {
+        reply = (ushort)(device.Transmit((byte)(frame >> 8)) << 8);
+        reply |= device.Transmit((byte)(frame & 0xff));
+      }
+      else
+      {
+        reply = device.Transmit((byte)(frame & 0xff));
+      }
+      if (rxBuffer.Count < rxBuffer.Capacity)
+      {
+        rxBuffer.Enqueue(reply);
+      }
+      if (Interlocked.Increment(ref framesOnWire) == 1)
+      {
+        StartFrameTimer();
+      }
+    }
+
+    // One frame lasts dataSize bit times; the timer counts nanoseconds.
+    private void StartFrameTimer()
+    {
+      var rate = bitRate == 0 ? 1UL : bitRate;
+      var bits = dataSize < 4 ? 4UL : (ulong)dataSize;
+      frameTimer.Enabled = false;
+      frameTimer.Limit = (bits * 1000000000UL + rate - 1UL) / rate;
+      frameTimer.Value = 0;
+      frameTimer.Enabled = true;
+    }
+
+    private void FrameDone()
+    {
+      if (Interlocked.Decrement(ref framesOnWire) > 0)
+      {
+        StartFrameTimer();
+      }
+    }
+
+    private bool FrameBusy()
+    {
+      return Volatile.Read(ref framesOnWire) > 0;
+    }
+
+    // Frames waiting in the transmit FIFO: every frame on the wire but the
+    // one in the shift register.
+    private int FrameFifoLevel()
+    {
+      var frames = Volatile.Read(ref framesOnWire);
+      return frames > 0 ? frames - 1 : 0;
+    }
+
     private void Step()
     {
       if (transmitCounter > dataSize - 1)
@@ -300,6 +385,8 @@
 
       rxBuffer.Clear();
       txBuffer.Clear();
+      frameTimer.Enabled = false;
+      Interlocked.Exchange(ref framesOnWire, 0);
 
       _executionThread.Stop();
 
@@ -361,6 +448,11 @@
           return 0;
         }, writeCallback: (_, value) =>
         {
+          if (RegisteredPeripheral != null)
+          {
+            TransferFrame(RegisteredPeripheral, (ushort)value);
+            return;
+          }
           Logger.Log(LogLevel.Noisy, "SPI{0}: Adding to queue: {1}", id, value);
           if (txBuffer.Count < txBuffer.Capacity)
           {
@@ -377,11 +469,11 @@
         }, name: "SSPDR_DATA");
 
       Registers.SSPSR.Define(registers)
-        .WithFlag(0, FieldMode.Read, valueProviderCallback: _ => txBuffer.Count == 0, name: "SSPSR_TFE")
-        .WithFlag(1, FieldMode.Read, valueProviderCallback: _ => txBuffer.Count != txBuffer.Capacity, name: "SSPSR_TNF")
+        .WithFlag(0, FieldMode.Read, valueProviderCallback: _ => txBuffer.Count == 0 && FrameFifoLevel() == 0, name: "SSPSR_TFE")
+        .WithFlag(1, FieldMode.Read, valueProviderCallback: _ => txBuffer.Count != txBuffer.Capacity && FrameFifoLevel() < txBuffer.Capacity, name: "SSPSR_TNF")
         .WithFlag(2, FieldMode.Read, valueProviderCallback: _ => rxBuffer.Count != 0, name: "SSPSR_RNE")
         .WithFlag(3, FieldMode.Read, valueProviderCallback: _ => rxBuffer.Count == rxBuffer.Capacity, name: "SSPSR_RFF")
-        .WithFlag(4, FieldMode.Read, valueProviderCallback: _ => running, name: "SSPSR_BSY");
+        .WithFlag(4, FieldMode.Read, valueProviderCallback: _ => running || FrameBusy(), name: "SSPSR_BSY");
 
       Registers.SSPCPSR.Define(registers)
         .WithValueField(0, 8, valueProviderCallback: _ => clockPrescaleDivisor,
@@ -441,6 +533,9 @@
     private bool slaveModeDisabled;
     private bool running;
     private byte clockPrescaleDivisor;
+    private ulong bitRate;
+    private readonly LimitTimer frameTimer;
+    private int framesOnWire;
 
     private DoubleWordRegisterCollection registers;
 
