+        // The transmit FIFO is a level counter: the bytes themselves go to the
+        // backend when DATA is written, and the counter stands for the
+        // characters the line would still be shifting out. It holds 32
+        // entries with FIFOs enabled and one without (RP2040 datasheet 4.2.2),
+        // counts the character in the shifter, and loses one entry per
+        // character time (start bit, data bits, parity bit, stop bits at
+        // the programmed divisors; 10 bit times for 8N1). A zero divisor
+        // gives 10 bit times at 115200 baud. The clock is the model's
+        // uartClockFrequency, not the system clock the firmware programs.
+        //
+        // The Transmit raw status follows datasheet 4.2.6.3: it is set when a
+        // drain step takes the level from above the trigger point to at or
+        // below it, and cleared by a write that raises the level above the
+        // trigger point or by ICR. The trigger point is 0 with FIFOs
+        // disabled, so the status is set when the single location empties and
+        // cleared by the next write. Nothing sets it at UARTEN or after reset,
+        // and a write that leaves the level at or below the trigger point
+        // leaves it alone. A write to a full FIFO is discarded before it
+        // reaches the backend and changes neither the level nor the status.
+        private uint TransmitCapacity => enableFifoBuffers.Value ? TransmitFifoDepth : 1;
+
+        private uint TransmitTriggerPoint => enableFifoBuffers.Value ? transmitInterruptTriggerPoint : 0;
+
+        private bool TryQueueTransmitCharacter()
+        {
+            if (transmitLevel >= TransmitCapacity)
+            {
+                this.Log(LogLevel.Warning, "DATA written while the transmit FIFO is full ({0} entries); the silicon discards the character.", transmitLevel);
+                return false;
+            }
+            transmitLevel++;
+            if (transmitLevel == 1)
+            {
+                StartTransmitTimer();
+            }
+            if (transmitLevel > TransmitTriggerPoint)
+            {
+                interruptRawStatuses[(int)Interrupts.Transmit] = false;
+            }
+            return true;
+        }
+
+        private void DrainTransmitCharacter()
+        {
+            lock (innerLock)
+            {
+                if (transmitLevel == 0)
+                {
+                    return;
+                }
+                var previousLevel = transmitLevel;
+                transmitLevel--;
+                if (previousLevel > TransmitTriggerPoint && transmitLevel <= TransmitTriggerPoint)
+                {
+                    interruptRawStatuses[(int)Interrupts.Transmit] = true;
+                }
+                if (transmitLevel != 0)
+                {
+                    StartTransmitTimer();
+                }
+                UpdateInterrupts();
+            }
+        }
+
+        private void StartTransmitTimer()
+        {
+            transmitTimer.Enabled = false;
+            transmitTimer.Limit = CharacterTimeNanoseconds();
+            transmitTimer.Value = 0;
+            transmitTimer.Enabled = true;
+        }
+
+        private ulong CharacterTimeNanoseconds()
+        {
+            var divisor64 = 64UL * integerBaudRate + fractionalBaudRate;
+            if (divisor64 == 0 || uartClockFrequency == 0)
+            {
+                return FallbackCharacterTimeNanoseconds;
+            }
+            var bits = 1UL + 5UL + (ulong)(int)wordLength.Value + (parityEnable.Value ? 1UL : 0UL) + (twoStopBitsSelect.Value ? 2UL : 1UL);
+            var nanoseconds = bits * divisor64 * 1000000000UL / (4UL * uartClockFrequency);
+            return nanoseconds == 0 ? 1UL : nanoseconds;
+        }
+
+        private void UpdateFifoMode()
+        {
+            UpdateReceiveFifoSize();
+            // A change of FEN empties the transmit FIFO; no character time elapses.
+            transmitTimer.Enabled = false;
+            transmitLevel = 0;
+        }
+
+        private void UpdateTransmitInterruptTriggerPoint()
+        {
+            switch (transmitInterruptFifoLevelSelect.Value)
+            {
+                case 0b000: transmitInterruptTriggerPoint = TransmitFifoDepth / 8; break;
+                case 0b001: transmitInterruptTriggerPoint = TransmitFifoDepth / 4; break;
+                case 0b010: transmitInterruptTriggerPoint = TransmitFifoDepth / 2; break;
+                case 0b011: transmitInterruptTriggerPoint = TransmitFifoDepth * 3 / 4; break;
+                case 0b100: transmitInterruptTriggerPoint = TransmitFifoDepth * 7 / 8; break;
+                default:
+                    this.Log(LogLevel.Warning, "Transmit interrupt FIFO level select written with invalid value: {0}", transmitInterruptFifoLevelSelect.Value);
+                    return;
+            }
+        }
+
