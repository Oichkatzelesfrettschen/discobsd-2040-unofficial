+    // The virtual time of a register access, in nanoseconds. The machine's
+    // time source advances only when every core has reported, so inside a
+    // time grant it stands still while the accessing core runs on. The
+    // core's own clock is its time handle plus the instructions executed
+    // since the handle was last read exactly (SyncTime); that reading is
+    // taken when the wire is idle, when another core takes over, when the
+    // handle overtakes the count, which a core that slept produces, and
+    // when the count falls below its base, which a core reset produces.
+    // Both the handle and the count leave out the translation block in
+    // flight, so the time is that of the start of the block making the
+    // access: a frame written to an idle controller is observed for its bit
+    // time less the instructions that precede the write in its block, plus
+    // those that precede the observing read in its own.
+    // An access from outside a core thread (the monitor) reads the machine.
+    private ulong AccessTime(ICPU cpu)
+    {
+      var core = cpu as BaseCPU;
+      if (core == null || !core.OnPossessedThread)
+      {
+        return frameMachine.ElapsedVirtualTime.TimeElapsed.Ticks;
+      }
+      var executed = core.ExecutedInstructions;
+      var mips = core.PerformanceInMips == 0 ? 1UL : core.PerformanceInMips;
+      var now = 0UL;
+      var rebase = core != clockCore || frameEnds.Count == 0 || executed < clockBaseInstructions;
+      if (!rebase)
+      {
+        now = clockBaseTicks + (executed - clockBaseInstructions) * 1000UL / mips;
+        rebase = core.TimeHandle.TotalElapsedTime.Ticks > now;
+      }
+      if (rebase)
+      {
+        core.SyncTime();
+        clockCore = core;
+        clockBaseTicks = core.TimeHandle.TotalElapsedTime.Ticks;
+        clockBaseInstructions = executed;
+        now = clockBaseTicks;
+      }
+      return now;
+    }
+
+    // Retires the frames that have left the wire by the time of this
+    // access. statusPoll marks a read of SSPSR: one that finds the transmit
+    // FIFO full comes from a driver polling for room, and the reading core
+    // skips to the end of the frame in the shift register, so the read
+    // returns TNF set after the virtual time the polling would have taken
+    // and without the register accesses of the loop. Such a read lasts up
+    // to one frame time, and an interrupt raised meanwhile waits that long.
+    private void SettleFrames(bool statusPoll)
     {
-      if (Interlocked.Decrement(ref framesOnWire) > 0)
+      lock (frameEnds)
