+          return;
+        }
+        frameMachine.SystemBus.TryGetCurrentCPU(out var cpu);
+        var now = AccessTime(cpu);
+        if (now > frameNow)
+        {
+          frameNow = now;
+        }
+        while (frameEnds.Count > 0 && frameEnds.Peek() <= frameNow)
+        {
+          frameEnds.Dequeue();
+        }
+        if (statusPoll && frameEnds.Count > txBuffer.Capacity && clockCore != null && cpu == clockCore)
+        {
+          var mips = clockCore.PerformanceInMips == 0 ? 1UL : clockCore.PerformanceInMips;
+          var cycle = mips >= 1000UL ? 1UL : 1000UL / mips;
+          var wait = (frameEnds.Peek() - frameNow + cycle - 1UL) / cycle * cycle;
+          clockCore.SkipTime(TimeInterval.FromTicks(wait));
+          clockBaseTicks += wait;
+          frameNow += wait;
+          frameEnds.Dequeue();
+        }
