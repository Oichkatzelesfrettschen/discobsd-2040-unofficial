#
# boardinfo: what the running kernel reports about its board. Read only; it
# needs no privilege and changes nothing. A name the kernel does not export
# (the PICO kernels carry no PicoCalc registers) prints "unavailable".
# BOARDINFO_PATH replaces the command search path for the host test.
PATH=${BOARDINFO_PATH-/sbin:/bin:/usr/sbin:/usr/bin}
export PATH

for name in kern.ostype kern.osrelease kern.version kern.hostname \
    hw.machine hw.model machdep.cpu_khz machdep.image_length \
    machdep.image_crc machdep.image_crc_stored machdep.watchdog_reason
do
	v=`sysctl -n $name 2>/dev/null`
	case "$v" in
	"")	v=unavailable ;;
	esac
	echo "$name: $v"
done

# The PicoCalc registers exist only in a PICOCALC kernel, and answer only
# with the keyboard controller attached.
if sysctl -n machdep.picocalc.battery >/dev/null 2>&1
then
	echo "board: PicoCalc registers answer"
else
	echo "board: no PicoCalc registers (PICO kernel, or no controller)"
fi

# The flash chip's unique ID: two ints, which sysctl prints signed. The
# shell's printf reads an operand with strtoul, so a negative half converts
# to its 32-bit pattern.
hi=`sysctl -n machdep.flash_unique_hi 2>/dev/null`
lo=`sysctl -n machdep.flash_unique_lo 2>/dev/null`
if test -n "$hi"
then
	if test -n "$lo"
	then
		id=`printf %08x%08x $hi $lo`
	fi
fi
echo "machdep.flash_unique: ${id-unavailable}"
echo "mounts:"
mount
